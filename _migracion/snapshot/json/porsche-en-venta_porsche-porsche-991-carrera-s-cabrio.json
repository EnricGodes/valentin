    "title" : "991 Carrera S Cabrio",
    "body" : "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6a6ccefe535bf603f01c0110\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-code code-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.code/66f3b523-d257-4442-a73a-a5a6a91f3464_901/website.components.code.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.code/66f3b523-d257-4442-a73a-a5a6a91f3464_901/website.components.code.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.code\" data-sqsp-block=\"code\" data-website-component-id=\"711953ae46354de5b353\" id=\"block-711953ae46354de5b353\"><div class=\"sqs-block-content\">\n  \n\n<div\n  class=\"sqs-code-container\"\n  \n  \n    data-localized=\"{&quot;enableSafeModeButton&quot;:&quot;Vista previa en modo seguro&quot;,&quot;enableSafeModeText&quot;:&quot;Este bloque contiene scripts integrados. Los scripts integrados est\u00E1n deshabilitados cuando has iniciado sesi\u00F3n y est\u00E1s editando tu sitio.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Scripts integrados&quot;,&quot;exitSafeModeButton&quot;:&quot;Salir de la vista previa segura&quot;,&quot;exitSafeModeText&quot;:&quot;Visualiza la p\u00E1gina despu\u00E9s de cerrar sesi\u00F3n para una conversi\u00F3n precisa.&quot;,&quot;exitSafeModeTitle&quot;:&quot;Vista previa segura&quot;,&quot;globalSafeMode&quot;:&quot;C\u00F3digo de inserci\u00F3n: Este bloque contiene c\u00F3digo de inserci\u00F3n que se ha deshabilitado.&quot;,&quot;scriptDisabled&quot;:&quot;Script desactivado&quot;}\"\n  \n  \n  \n  \n>\n  \n    <!-- =========================================================\n     VALENTIN MOTORS \u00B7 EMBEDDED CAR POST\n     SOLO CAMBIAR EL BLOQUE \"CONFIGURACI\u00D3N DEL COCHE\"\n========================================================= -->\n\n<script>\n  /* =========================================================\n     \uD83D\uDD34 CONFIGURACI\u00D3N DEL COCHE \u2014 CAMBIAR EN CADA POST\n  ========================================================= */\n\n  const VM_CAR_TITLE = \"Porsche 991 Carrera S Cabrio\";\n  const VM_CAR_PAGE_TITLE = \"Porsche 991 Carrera S Cabrio \u00B7 Valentin Motors\";\n  const VM_CAR_IFRAME_URL = \"https://valentin.up.railway.app/991scabrio.html?embed=1\";\n  const VM_CAR_DESCRIPTION = \"Porsche 991 Carrera S Cabrio disponible en Valentin Motors.\";\n\n  /* =========================================================\n     NO TOCAR A PARTIR DE AQU\u00CD\n  ========================================================= */\n\n  document.documentElement.classList.add(\"vm-embedded-car-post\");\n  document.title = VM_CAR_PAGE_TITLE;\n\n  function vmSetMetaTag(selector, attribute, value) {\n    const tag = document.querySelector(selector);\n    if (tag) {\n      tag.setAttribute(attribute, value);\n    }\n  }\n\n  vmSetMetaTag('meta[property=\"og:title\"]', \"content\", VM_CAR_PAGE_TITLE);\n  vmSetMetaTag('meta[name=\"twitter:title\"]', \"content\", VM_CAR_PAGE_TITLE);\n  vmSetMetaTag('meta[name=\"description\"]', \"content\", VM_CAR_DESCRIPTION);\n  vmSetMetaTag('meta[property=\"og:description\"]', \"content\", VM_CAR_DESCRIPTION);\n  vmSetMetaTag('meta[name=\"twitter:description\"]', \"content\", VM_CAR_DESCRIPTION);\n\n  window.addEventListener(\"load\", function () {\n    const embed = document.querySelector(\".vm-car-embed-section\");\n    const iframe = document.querySelector(\".vm-car-embed-section iframe\");\n\n    if (iframe) {\n      iframe.src = VM_CAR_IFRAME_URL;\n      iframe.title = VM_CAR_PAGE_TITLE;\n    }\n\n    if (!embed) return;\n\n    const selectorsToClean = [\n      \".sqs-block-code\",\n      \".sqs-block-content\",\n      \".sqs-block\",\n      \".sqs-row\",\n      \".sqs-layout\",\n      \".blog-item-content\",\n      \".blog-item-inner-wrapper\",\n      \".blog-item-wrapper\"\n    ];\n\n    selectorsToClean.forEach(function (selector) {\n      const el = embed.closest(selector);\n      if (el) {\n        el.style.marginTop = \"0\";\n        el.style.marginBottom = \"0\";\n        el.style.paddingTop = \"0\";\n        el.style.paddingBottom = \"0\";\n        el.style.background = \"#050505\";\n        el.style.lineHeight = \"0\";\n        el.style.fontSize = \"0\";\n      }\n    });\n\n    if (!document.querySelector(\".vm-bottom-seam-cover\")) {\n      const seamCover = document.createElement(\"div\");\n      seamCover.className = \"vm-bottom-seam-cover\";\n      embed.insertAdjacentElement(\"afterend\", seamCover);\n    }\n  });\n</script>\n\n<style>\n  /* =========================================================\n     HIDE SQUARESPACE BLOG HEADER / METADATA\n  ========================================================= */\n\n  html.vm-embedded-car-post .blog-item-title,\n  html.vm-embedded-car-post .blog-meta-item,\n  html.vm-embedded-car-post .blog-item-author-date-wrapper,\n  html.vm-embedded-car-post .blog-item-author-profile-wrapper,\n  html.vm-embedded-car-post .blog-item-top-wrapper,\n  html.vm-embedded-car-post .item-pagination {\n    display: none !important;\n  }\n\n  /* =========================================================\n     REMOVE SQUARESPACE TOP/BOTTOM SPACING\n  ========================================================= */\n\n  html.vm-embedded-car-post main,\n  html.vm-embedded-car-post #page,\n  html.vm-embedded-car-post .page-section,\n  html.vm-embedded-car-post .blog-item-wrapper,\n  html.vm-embedded-car-post .blog-item-inner-wrapper,\n  html.vm-embedded-car-post .blog-item-content,\n  html.vm-embedded-car-post .sqs-layout,\n  html.vm-embedded-car-post .sqs-row,\n  html.vm-embedded-car-post .sqs-block,\n  html.vm-embedded-car-post .sqs-block-code,\n  html.vm-embedded-car-post .sqs-block-content {\n    margin-top: 0 !important;\n    margin-bottom: 0 !important;\n    padding-top: 0 !important;\n    padding-bottom: 0 !important;\n  }\n\n  /* =========================================================\n     FORCE BLACK BACKGROUND AROUND EMBEDDED AREA\n  ========================================================= */\n\n  html.vm-embedded-car-post .blog-item-content,\n  html.vm-embedded-car-post .blog-item-content .sqs-layout,\n  html.vm-embedded-car-post .blog-item-content .sqs-row,\n  html.vm-embedded-car-post .blog-item-content .sqs-col-12,\n  html.vm-embedded-car-post .blog-item-content .sqs-block,\n  html.vm-embedded-car-post .blog-item-content .sqs-block-code,\n  html.vm-embedded-car-post .blog-item-content .sqs-block-content {\n    background: #050505 !important;\n  }\n\n  /* =========================================================\n     REMOVE CODE BLOCK BASELINE GAP\n  ========================================================= */\n\n  html.vm-embedded-car-post .sqs-block-code,\n  html.vm-embedded-car-post .sqs-block-code .sqs-block-content {\n    line-height: 0 !important;\n    font-size: 0 !important;\n    overflow: visible !important;\n    background: #050505 !important;\n  }\n\n  /* =========================================================\n     MAIN IFRAME SECTION\n  ========================================================= */\n\n  html.vm-embedded-car-post .vm-car-embed-section {\n    width: 100vw;\n    height: 100svh;\n    min-height: 760px;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    margin-top: -10px !important;\n    margin-bottom: 0 !important;\n    padding: 0 !important;\n    background: #050505 !important;\n    overflow: visible !important;\n    position: relative !important;\n    z-index: 50 !important;\n    line-height: 0 !important;\n    font-size: 0 !important;\n  }\n\n  html.vm-embedded-car-post .vm-car-embed-section iframe {\n    width: 100%;\n    height: 100%;\n    border: 0 !important;\n    display: block !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    background: #050505 !important;\n    vertical-align: bottom !important;\n  }\n\n  /* =========================================================\n     COVER RESIDUAL WHITE SEAM AFTER IFRAME\n  ========================================================= */\n\n  html.vm-embedded-car-post .vm-car-embed-section::after {\n    content: \"\" !important;\n    position: absolute !important;\n    left: 0 !important;\n    right: 0 !important;\n    bottom: -60px !important;\n    height: 80px !important;\n    background: #050505 !important;\n    pointer-events: none !important;\n    z-index: 999999 !important;\n  }\n\n  html.vm-embedded-car-post .vm-bottom-seam-cover {\n    display: block !important;\n    width: 100vw !important;\n    height: 80px !important;\n    margin-left: calc(50% - 50vw) !important;\n    margin-right: calc(50% - 50vw) !important;\n    margin-top: -1px !important;\n    margin-bottom: -80px !important;\n    padding: 0 !important;\n    background: #050505 !important;\n    position: relative !important;\n    z-index: 999999 !important;\n    pointer-events: none !important;\n    line-height: 0 !important;\n    font-size: 0 !important;\n  }\n\n  /* =========================================================\n     REMOVE SPACING BEFORE NEXT SQUARESPACE BLOCK\n  ========================================================= */\n\n  html.vm-embedded-car-post .blog-item-content + *,\n  html.vm-embedded-car-post .blog-item-wrapper + *,\n  html.vm-embedded-car-post .blog-item-inner-wrapper + * {\n    margin-top: 0 !important;\n    padding-top: 0 !important;\n  }\n\n  html.vm-embedded-car-post footer,\n  html.vm-embedded-car-post .Footer,\n  html.vm-embedded-car-post .site-footer {\n    margin-top: 0 !important;\n  }\n\n  /* =========================================================\n     MOBILE\n  ========================================================= */\n\n  @media (max-width: 767px) {\n    html.vm-em