---
import { IDIOMAS, HREFLANG, DOMINIO, type Idioma } from '../i18n/config';
import { alternantes, xDefault, urlAbsoluta } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import Cursor from '../components/Cursor.astro';
import Analitica from '../components/Analitica.astro';
import BannerCookies from '../components/BannerCookies.astro';
import '../styles/fuentes.css';
import '../styles/tokens.css';
import '../styles/system.css';

interface Props {
  idioma: Idioma;
  /** Id de ruta en el manifiesto: de aqui salen canonical y hreflang. */
  rutaId: string;
  /** Segmentos extra ya traducidos (slug de post, de coche, de categoria). */
  extra?: string[];
  /** Idiomas realmente publicados de esta pagina. Nunca se declara un
      hreflang hacia algo que no existe. */
  idiomasPublicados?: readonly Idioma[];
  titulo: string;
  descripcion: string;
  /** Clase de realce del vehiculo, p. ej. "realce--ruf". */
  realce?: string;
  imagen?: string;
  /** `article` en los posts del Magazine; el resto es `website`. */
  ogTipo?: 'website' | 'article';
  noindex?: boolean;
  /** Contexto para los eventos de conversion: que tipo de pagina es y, si
      procede, de que coche. Sin esto no se sabe QUE ficha genero el contacto. */
  tipoPagina?: string;
  coche?: string;
}

const {
  idioma, rutaId, extra = [], idiomasPublicados = IDIOMAS,
  titulo, descripcion, realce = '', imagen, ogTipo = 'website', noindex = false,
  tipoPagina, coche,
} = Astro.props;

const t = traductor(idioma);
const canonical = urlAbsoluta(rutaId, idioma, ...extra);
const alt = alternantes(rutaId, idiomasPublicados, ...extra);
/* Sin imagen propia, la del taller: compartida en WhatsApp o LinkedIn una
   pagina sin og:image sale como un enlace desnudo. */
const og = new URL(imagen ?? '/img/paginas/47048331-taller01.jpg', DOMINIO).href;
const LOCALE: Record<Idioma, string> = {
  es: 'es_ES', en: 'en_GB', fr: 'fr_FR', it: 'it_IT', de: 'de_DE', ca: 'ca_ES',
};
---
<!doctype html>
<html lang={idioma} class={realce}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{titulo}</title>
  <meta name="description" content={descripcion}>
  {/* El triangulo de Valentin en bronce, sobre transparente; el de Apple va
      sobre negro carbon porque iOS rellena de blanco la transparencia. */}
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {/* Una pagina noindex (la 404, /sistema) no declara canonical ni hreflang:
      apuntar a otra URL desde algo que no se indexa solo confunde. */}
  {noindex ? <meta name="robots" content="noindex, nofollow"> : <link rel="canonical" href={canonical}>}

  {/* Cada version de idioma es canonica de si misma y declara a todas las
      demas, incluida ella. Sin reciprocidad Google ignora el conjunto. */}
  {!noindex && alt.map(({ idioma: i, href }) => (
    <link rel="alternate" hreflang={HREFLANG[i]} href={href}>
  ))}
  {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault(rutaId, ...extra)}>}

  <meta property="og:type" content={ogTipo}>
  <meta property="og:site_name" content="Valentín Motors">
  <meta property="og:title" content={titulo}>
  <meta property="og:description" content={descripcion}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={LOCALE[idioma]}>
  {!noindex && alt.filter((a) => a.idioma !== idioma).map((a) => (
    <meta property="og:locale:alternate" content={LOCALE[a.idioma]}>
  ))}
  <meta property="og:image" content={og}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={titulo}>
  <meta name="twitter:description" content={descripcion}>
  <meta name="twitter:image" content={og}>

  {/* Inter es la del cuerpo: se precarga para que el primer pintado no
      cambie de letra. Las demas llegan con src/styles/fuentes.css. */}
  <link rel="preload" href="/fonts/web/inter-latin-bec94a4d.woff2" as="font" type="font/woff2" crossorigin>

  <slot name="head" />
  <Analitica />
</head>
<body data-tipo-pagina={tipoPagina} data-coche={coche}>
  <a class="saltar" href="#contenido">{t('a11y.saltar')}</a>
  <Cursor />
  <slot name="nav" />
  <main id="contenido"><slot /></main>
  <slot name="pie" />
  <BannerCookies idioma={idioma} />
  <script>
    import '../scripts/index';
  </script>
</body>
</html>
