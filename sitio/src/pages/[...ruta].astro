---
/**
 * Ruta general del sitio, resuelta desde el manifiesto src/i18n/routes.ts.
 *
 * Existe una sola pagina para todos los idiomas: los slugs traducidos salen del
 * manifiesto, no de la estructura de carpetas. Asi anadir un idioma es anadir
 * una columna al manifiesto, no duplicar el arbol de src/pages.
 */
import { IDIOMAS, type Idioma } from '../i18n/config';
import { url, urlAbsoluta } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Pie from '../components/Pie.astro';
import FichaCoche from '../components/FichaCoche.astro';
import CatalogoCoches from '../components/CatalogoCoches.astro';
import SeccionesPagina from '../components/SeccionesPagina.astro';
import Acordeon from '../components/Acordeon.astro';
import Tarifas from '../components/Tarifas.astro';
import tarifas from '../datos/tarifas.json';
import CasosMagazine from '../components/CasosMagazine.astro';
import { getCollection } from 'astro:content';
import Formulario from '../components/Formulario.astro';
import NegocioLocal from '../components/seo/NegocioLocal.astro';
import Vehiculo from '../components/seo/Vehiculo.astro';
import Migas from '../components/seo/Migas.astro';
import { cochesDe, idiomasDeCoche, idiomasConCatalogo, type Coche } from '../datos/coche';
import { PAGINAS_CONTENIDO, idiomasDe, separarFaq, type Pagina } from '../datos/pagina';
import PreguntasFrecuentes from '../components/PreguntasFrecuentes.astro';
import { VENDIDOS, type Vendido } from '../datos/vendido';
import FichaVendido from '../components/FichaVendido.astro';
import UnidadesGeneracion from '../components/UnidadesGeneracion.astro';
import { landingDeCoche } from '../datos/generacion';

export async function getStaticPaths() {
  const rutas: any[] = [];
  const sinBarra = (u: string) => u.replace(/^\//, '');

  // Catalogo y fichas, solo en los idiomas que tienen fichas traducidas.
  // Publicar el catalogo aleman con seis fichas en espanol no ayuda a nadie.
  for (const idioma of idiomasConCatalogo()) {
    rutas.push({
      params: { ruta: sinBarra(url('coches', idioma)) },
      props: { tipo: 'catalogo', idioma },
    });

    // El slug del coche NO se traduce: son designaciones de modelo
    // ("porsche-997-manual"), iguales en los seis mercados, y en espanol
    // ademas estan congeladas porque ya posicionan.
    for (const coche of cochesDe(idioma)) {
      rutas.push({
        params: { ruta: sinBarra(url('coches', idioma, coche.slug)) },
        props: { tipo: 'ficha', idioma, coche },
      });
    }
  }

  // Coches vendidos sin ficha recuperable, en los seis idiomas: su texto vive
  // en ui.ts, asi que existen en todos.
  for (const idioma of IDIOMAS) {
    for (const v of VENDIDOS) {
      rutas.push({
        params: { ruta: sinBarra(url('coches', idioma, v.slug)) },
        props: { tipo: 'vendido', idioma, vendido: v },
      });
    }
  }

  // Servicios, tarifas, centros, institucional y legales: una entrada por cada
  // idioma en el que la pagina EXISTE. Las que aun no estan traducidas no se
  // publican en ese idioma, y por tanto tampoco se declaran en el hreflang.
  for (const { idioma, pagina } of PAGINAS_CONTENIDO) {
    rutas.push({
      params: { ruta: sinBarra(url(pagina.rutaId, idioma)) },
      props: { tipo: 'pagina', idioma, pagina },
    });
  }
  return rutas;
}

type Props =
  | { tipo: 'catalogo'; idioma: Idioma }
  | { tipo: 'ficha'; idioma: Idioma; coche: Coche }
  | { tipo: 'pagina'; idioma: Idioma; pagina: Pagina }
  | { tipo: 'vendido'; idioma: Idioma; vendido: Vendido };

const props = Astro.props as Props;
const { idioma } = props;
const t = traductor(idioma);

const coche = props.tipo === 'ficha' ? props.coche : undefined;
const pagina = props.tipo === 'pagina' ? props.pagina : undefined;
const vendido = props.tipo === 'vendido' ? props.vendido : undefined;

const rutaId = pagina ? pagina.rutaId : 'coches';
const extra = coche ? [coche.slug] : vendido ? [vendido.slug] : [];

const titulo = coche?.meta.titulo
  ?? pagina?.meta.titulo
  ?? (vendido ? `${vendido.nombre} · ${t('estado.vendido')} · Valentin Motors` : null)
  ?? t('catalogo.titulo');
// El listado no tenia meta description en Squarespace, asi que Google se
// inventaba el texto del resultado a partir del contenido de la pagina.
const descripcion = coche?.meta.descripcion
  ?? pagina?.meta.descripcion
  ?? vendido?.descripcion
  ?? t('catalogo.descripcion');

/* Solo se declaran las alternantes que existen de verdad. Declarar un hreflang
   hacia una pagina no publicada es uno de los tres errores que hacen que Google
   descarte el grupo entero. */
const idiomasPublicados = pagina
  ? idiomasDe(pagina.rutaId)
  : coche ? idiomasDeCoche(coche.slug)
  : vendido ? IDIOMAS
  : idiomasConCatalogo();

/* Migas de pan: la ficha cuelga del catalogo y, si su generacion tiene
   landing, pasa por ella: Porsche en venta > Porsche 997 de segunda mano >
   997.1 Carrera 4S. Es la forma de que cada ficha empuje a su landing sin
   meter las landings en el menu. Solo si la landing existe en este idioma. */
const landingGen = (slug: string) => {
  const id = landingDeCoche(slug);
  if (!id || !idiomasDe(id).includes(idioma)) return [];
  const p = PAGINAS_CONTENIDO.find((x) => x.idioma === idioma && x.pagina.rutaId === id)?.pagina;
  return p ? [{ nombre: p.h1, rutaId: id }] : [];
};
const migas = coche
  ? [{ nombre: t('nav.coches'), rutaId: 'coches' }, ...landingGen(coche.slug),
     { nombre: coche.catalogo?.nombre ?? coche.slug, rutaId: 'coches', extra: [coche.slug] }]
  : vendido
  ? [{ nombre: t('nav.coches'), rutaId: 'coches' }, ...landingGen(vendido.slug),
     { nombre: vendido.nombre, rutaId: 'coches', extra: [vendido.slug] }]
  : pagina
    ? [{ nombre: pagina.h1 || titulo, rutaId: pagina.rutaId }]
    : [{ nombre: t('nav.coches'), rutaId: 'coches' }];

/* Las tarifas ya no se pintan como acordeon: sus precios viven en
   datos/tarifas.json y los pinta el buscador de modelos. El resto de paginas
   con acordeon (que no son tarifas) sigue igual. */
const familiaTarifa = tarifas.familias.find((f) => f.rutaId === pagina?.rutaId)?.id;
/* El indice de tarifas lleva el buscador entero, con las seis familias; cada
   pagina de familia, solo la suya. */
const esIndiceTarifas = pagina?.rutaId === 'taller-tarifas';

/* La pagina del taller traia la seccion "Tarifas de mantenimiento" seguida de
   seis subsecciones que solo listaban modelos: en Squarespace cada una era un
   enlace a su pagina de tarifas y la migracion se dejo los enlaces, asi que
   quedaron seis listas muertas y seis paginas a las que no llegaba nadie.
   En su lugar va el buscador con los 57 modelos. Las subsecciones se localizan
   por su nivel y no por su titulo, que cambia en cada idioma. */
/* Las preguntas frecuentes salen del flujo: tienen su propia grafica al final
   de la pagina y su FAQPage en el <head>. */
const { resto: secciones, faq } = separarFaq(pagina?.secciones ?? []);
const sinHtml = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const faqSchema = faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${urlAbsoluta(pagina!.rutaId, idioma)}#faq`,
  inLanguage: idioma,
  mainEntity: faq.preguntas.map((p) => ({
    '@type': 'Question', name: sinHtml(p.pregunta),
    acceptedAnswer: { '@type': 'Answer', text: sinHtml(p.respuesta.join(' ')).slice(0, 900) },
  })),
};

/* Landing de generacion ("Porsche 997 de segunda mano"). Sus unidades van
   debajo del titulo, antes del texto; lo demas (vacio, vendidos, otras
   generaciones, guia y formulario de aviso) al final. El nombre legible
   ("Porsche 986 Boxster") es el `menu` de la propia pagina. */
const generacion = pagina?.tipo === 'landing'
  ? pagina.rutaId.match(/^ocasion-(.+)$/)?.[1] : undefined;
const nombreGeneracion = pagina?.menu ?? `Porsche ${generacion}`;

const iTarifas = pagina?.rutaId === 'taller'
  ? secciones.findIndex((s, i) => secciones[i + 1]?.nivel === 4) : -1;
let iFin = iTarifas;
while (iFin >= 0 && secciones[iFin + 1]?.nivel === 4) iFin++;
const antesDeTarifas = iTarifas >= 0 ? secciones.slice(0, iTarifas + 1) : secciones;
const despuesDeTarifas = iTarifas >= 0 ? secciones.slice(iFin + 1) : [];

/* Los articulos que sostienen esta pagina, en el orden en que los declara.
   Se cae al castellano cuando el articulo no esta traducido: mejor leerlo en
   espanol que no encontrarlo. */
const todos = pagina?.articulos?.length ? await getCollection('magazine') : [];
const relacionados = (pagina?.articulos ?? [])
  .map((slug) => todos.find((p) => p.data.slugFinal === slug && p.data.lang === idioma)
                 ?? todos.find((p) => p.data.slugFinal === slug && p.data.lang === 'es'))
  .filter((p) => p !== undefined);

/* Paginas de tarifas (el indice y las seis familias): el buscador de precios
   es a lo que se viene, asi que va justo despues de la primera seccion, no
   al final de la pagina. La foto de esa primera seccion baja con el resto:
   se cuelga de la primera seccion posterior que no tenga foto, y si todas
   tienen, va sola detras del buscador. */
const esTarifas = Boolean(familiaTarifa || esIndiceTarifas);
let antesTarifasPag = secciones;
let despuesTarifasPag: typeof secciones = [];
if (esTarifas && secciones.length) {
  /* En las seis familias la unica seccion con texto es "Haz una reserva", que
     va detras del buscador, no delante: el buscador abre la pagina. */
  const i0 = familiaTarifa ? -1 : secciones.findIndex((s, i) => !(i === 0 && s.nivel === 1));
  const primera = i0 >= 0 ? secciones[i0] : undefined;
  /* En las familias la foto cuelga de la seccion del H1, que no se pinta:
     se rescata de ahi para que vaya debajo del buscador. */
  const fotos = primera?.imagenes ?? (familiaTarifa ? secciones[0]?.imagenes ?? [] : []);
  antesTarifasPag = primera ? [...secciones.slice(0, i0), { ...primera, imagenes: [] }] : [];
  despuesTarifasPag = secciones.slice(i0 + 1).map((s) => ({ ...s }));
  if (fotos.length) {
    const hueco = despuesTarifasPag.find((s) => !s.imagenes.length);
    if (hueco) hueco.imagenes = fotos;
    else despuesTarifasPag.unshift({ nivel: 0, titulo: '', parrafos: [], items: [], imagenes: fotos });
  }
}

const esVende = pagina?.rutaId === 'vende';
const esCentro = pagina?.tipo === 'centro';
const centro = esCentro ? (pagina!.rutaId as 'barcelona' | 'madrid') : 'ambos';
---
<Base
  idioma={idioma}
  rutaId={rutaId}
  extra={extra}
  idiomasPublicados={idiomasPublicados}
  titulo={titulo}
  descripcion={descripcion}
  realce={coche?.realce ?? ''}
  imagen={coche?.hero.imagen}
  tipoPagina={coche ? 'ficha' : vendido ? 'vendido' : pagina?.tipo ?? 'catalogo'}
  coche={coche?.slug ?? vendido?.slug}
>
  <Fragment slot="head">
    {(esCentro || pagina?.tipo === 'contacto') && <NegocioLocal centro={centro} />}
    {coche && <Vehiculo coche={coche} idioma={idioma} />}
    <Migas migas={migas} idioma={idioma} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline></script>}
  </Fragment>
  <Nav slot="nav" idioma={idioma} rutaId={rutaId} extra={extra}
       idiomasPublicados={idiomasPublicados} />
  <Pie slot="pie" idioma={idioma} rutaId={rutaId} extra={extra} idiomasPublicados={idiomasPublicados} />

  {coche && <FichaCoche coche={coche} idioma={idioma} />}
  {coche && <Formulario idioma={idioma} coche={coche.slug}
                        cocheNombre={coche.catalogo?.nombre ?? coche.slug} />}
  {vendido && <FichaVendido coche={vendido} idioma={idioma} />}

  {pagina && (
    <article class="pagina">
      <header class="page-header">
        <div class="shimmer-line reveal"></div>
        <h1 class="page-title reveal">{pagina.h1 || titulo}</h1>
      </header>
      {generacion && (
        <UnidadesGeneracion generacion={generacion} nombre={nombreGeneracion}
                            rutaId={pagina.rutaId} idioma={idioma} parte="arriba" />
      )}
      <SeccionesPagina secciones={esTarifas ? antesTarifasPag : antesDeTarifas} idioma={idioma} />
      {esTarifas && (
        <div class="contenido tarifas-modulo">
          <Tarifas idioma={idioma} familia={familiaTarifa} textos={{
            familia: t('tarifas.familia'), modelo: t('tarifas.modelo'),
            nota: t('tarifas.nota'),
          }} />
        </div>
      )}
      {despuesTarifasPag.length > 0 && <SeccionesPagina secciones={despuesTarifasPag} idioma={idioma} />}
      {iTarifas >= 0 && (
        <div class="contenido">
          <Tarifas idioma={idioma} textos={{
            familia: t('tarifas.familia'), modelo: t('tarifas.modelo'),
            nota: t('tarifas.nota'),
          }} />
        </div>
      )}
      {despuesDeTarifas.length > 0 && <SeccionesPagina secciones={despuesDeTarifas} idioma={idioma} />}
      {generacion && (
        <UnidadesGeneracion generacion={generacion} nombre={nombreGeneracion}
                            rutaId={pagina.rutaId} idioma={idioma} parte="abajo" />
      )}
      {faq && <PreguntasFrecuentes faq={faq} idioma={idioma} />}
      {relacionados.length > 0 && (
        <CasosMagazine posts={relacionados} idioma={idioma} tipo={generacion ? 'guia' : 'caso'}
                       titulo={t(generacion ? 'generacion.guia' : 'pagina.articulos')} />
      )}
      {!esTarifas && pagina.acordeones.length > 0 && (
        <div class="contenido"><Acordeon items={pagina.acordeones} /></div>
      )}
    </article>
  )}

  {props.tipo === 'catalogo' && <CatalogoCoches coches={cochesDe(idioma)} idioma={idioma} />}

  {(pagina?.tipo === 'contacto' || esCentro || vendido) && <Formulario idioma={idioma}
      coche={vendido?.slug} cocheNombre={vendido?.nombre} />}
  {/* La landing lleva su propio formulario de aviso: haya o no unidades, quien
      busca un 997 concreto quiere que le avisen del siguiente. */}
  {generacion && <Formulario idioma={idioma} asunto="compra"
      busca={nombreGeneracion}
      titulo={t('generacion.formTitulo').replace('{gen}', nombreGeneracion)}
      intro={t('generacion.formIntro')} />}
  {esVende && <Formulario idioma={idioma} asunto="venta"
      titulo={t('vende.formTitulo')} intro={t('vende.formIntro')} />}
</Base>
