---
/**
 * Home. Es la pagina con mas trafico del sitio: 1.311 clics organicos y 15.749
 * impresiones en tres meses.
 *
 * A diferencia del resto de paginas de contenido, no se renderiza en bloque
 * desde el JSON extraido: se compone a mano y toma los coches y los articulos
 * de sus fuentes vivas, para que no haya que tocar la home cada vez que entra
 * un coche o se publica un post.
 *
 * El movimiento (GSAP + ScrollTrigger) vive en src/scripts/home.ts y solo
 * anade: sin JS o con movimiento reducido todo el contenido esta en su sitio.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ListaMagazine from '../components/ListaMagazine.astro';
import Nav from '../components/Nav.astro';
import Pie from '../components/Pie.astro';
import Hero from '../components/Hero.astro';
import CabeceraSeccion from '../components/CabeceraSeccion.astro';
import NegocioLocal from '../components/seo/NegocioLocal.astro';
import { url } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import { COCHES } from '../datos/coche';
import { paginaPorRuta } from '../datos/pagina';
import { RESENAS, GOOGLE_FICHA, GOOGLE_NOTA, haceCuanto } from '../datos/testimonios';
import '../styles/home.css';

const idioma = 'es' as const;
const t = traductor(idioma);
const home = paginaPorRuta('home')!;

/* Todos los que no estan vendidos, reservados incluidos. Antes habia un
   slice(0, 3) y el cuarto coche en venta no salia en la home. */
const enVenta = COCHES.filter((c) => c.catalogo?.estado !== 'vendido');
/* Filtrado por idioma: sin esto getCollection devuelve las 252 entradas de
   los seis idiomas y los tres mas recientes son el MISMO articulo en espanol,
   aleman e ingles. Se veia en la portada como tres tarjetas repetidas.

   Los tres ultimos se parecian demasiado (casi siempre restauraciones), asi
   que la home saca tres al azar. Aqui se prepara una bolsa variada, hasta
   tres por categoria, y en el navegador home.ts elige tres de categorias
   distintas en cada visita. Sin JS se ven los tres primeros de la bolsa. */
const barajar = <T,>(a: T[]) => a.map((x) => [Math.random(), x] as const)
  .sort((x, y) => x[0] - y[0]).map(([, x]) => x);
const porCategoria = new Map<string, CollectionEntry<'magazine'>[]>();
for (const p of await getCollection('magazine', (p) => p.data.lang === idioma)) {
  const c = p.data.categories[0] ?? 'otros';
  porCategoria.set(c, [...(porCategoria.get(c) ?? []), p]);
}
const bolsa = [...porCategoria.values()].map((ps) => barajar(ps).slice(0, 3));
/* Intercalado por categoria: los tres primeros, que son los que se ven sin
   JS, ya salen de categorias distintas. */
const posts = Array.from({ length: 3 }, (_, i) => bolsa.map((ps) => ps[i]))
  .flat().filter((p): p is CollectionEntry<'magazine'> => Boolean(p));
const sinHtml = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const ANOS = new Date().getFullYear() - 1979;

const CIFRAS = [
  { valor: ANOS, unidad: 'años', texto: 'Solo con Porsche, desde 1979' },
  { valor: 2, unidad: 'centros', texto: 'Barcelona y Madrid' },
  { valor: 3820, unidad: 'm²', texto: 'De taller entre los dos' },
  { valor: 8, unidad: 'generaciones', texto: 'Del 356 al 991, de memoria' },
];

const PILARES = [
  { titulo: 'Precio cerrado',
    texto: 'Tarifas de mantenimiento publicadas por modelo. Sabes lo que vas a pagar antes de dejar el coche.' },
  { titulo: 'Sala de motores',
    texto: 'Desmontaje, medición y reconstrucción en una sala propia. Diagnóstico de IMS y bore scoring con datos, no con suposiciones.' },
  { titulo: 'Coches que conocemos',
    texto: 'Vendemos pocos Porsche y los elegimos uno a uno. Cada ficha cuenta lo que tiene el coche y también lo que no.' },
];

const SERVICIOS = [
  { id: 'taller', titulo: 'Taller mecánico',
    foto: '/img/paginas/8c07e3b4-Cajas-de-cambio-Porsche.jpg',
    alt: 'Porsche 964 en el elevador del taller de Valentin Motors',
    texto: 'Mantenimiento a precio cerrado, diagnosis, IMS y bore scoring para todas las generaciones. Con sala de motores propia para desmontar, medir y reconstruir.' },
  { id: 'restauraciones', titulo: 'Restauración',
    foto: '/img/paginas/5be75eeb-efa871d3-06cd-4c03-ad1e-94aa3ed556e6.jpg',
    alt: 'Carrocería de un 911 clásico preparada en la cabina de pintura',
    texto: 'Restauración integral, backdating y restomod. Chapa, pintura, tapicería y mecánica con criterio de época y cada paso documentado.' },
  { id: 'competicion', titulo: 'Preparación',
    foto: '/img/paginas/84ac2fae-DSC07852.jpg',
    alt: 'Porsche de competición en el pit lane durante una jornada en circuito',
    texto: 'Track days, campeonatos GT y rally. Suspensión, frenos y reglajes pensados para el uso real que va a tener el coche.' },
  { id: 'restauraciones-personalizacion', titulo: 'Personalización',
    foto: '/img/pa10-01/interior-1280.webp',
    alt: 'Interior a medida con tapicería de cuadros del proyecto PA10/01',
    texto: 'Interiores a medida, tapicerías de época, iluminación y suspensión. Proyectos únicos, como el PA10/01, hechos con el cliente pieza a pieza.' },
];

const CENTROS = [
  {
    id: 'barcelona', nombre: 'Barcelona',
    direccion: 'Varsòvia, 65 · 08041 Barcelona',
    detalle: 'Junto a la Ronda del Mig. 1.320 m² de taller.',
    telefono: '933 479 856', tel: '+34933479856',
    horario: 'Lunes a viernes, 8:00 a 18:00',
    foto: '/img/paginas/6898818b-vm.jpg',
  },
  {
    id: 'madrid', nombre: 'Madrid',
    direccion: 'Puig Adam, 10 · 28914 Leganés',
    detalle: 'Pol. Butarque, a 20 minutos del centro. 2.500 m².',
    telefono: '913 017 575', tel: '+34913017575',
    horario: 'Lunes a viernes, 8:30 a 18:00',
    foto: '/img/paginas/9fcf69d9-fachada_madrid.jpg',
  },
];

/* Fragmentos de 8 s de cada reel, sin audio. Los originales estan en
   docs/ig home/. */
const REELS = [
  { id: 'DXMwohoiBdX', titulo: 'El 911 total', texto: 'Si solo pudieras tener un 911, ¿cuál sería?' },
  { id: 'DY2a6a4I9vb', titulo: 'GT4, GTS o GT3', texto: 'Tres atmosféricos frente a frente. ¿Cuál es mejor?' },
  { id: 'DbIT-GPI0Co', titulo: 'Configuración clásica', texto: 'Cabriolet, tracción trasera y cambio manual.' },
  { id: 'DdmDavso1zy', titulo: 'Mantenimiento del motor 993', texto: 'Juntas, tapas y Variocam del último 3.6 refrigerado por aire.' },
  { id: 'DdCAgG3IPVn', titulo: 'Interior de cuadros', texto: 'Un 911 con tapicería de tartán, visto de cerca.' },
  { id: 'DeRL5PWI3vD', titulo: '997.1 o 997.2', texto: 'Pros y contras de las dos fases del 997.' },
];

/* Los perfiles de cada generacion salen de home.json; en la home anterior
   estaban en el JSON pero no se usaban. Se ordenan por fecha, no por el orden
   de Squarespace, y cada uno enlaza a su landing de segunda mano. */
const GENERACIONES: Record<string, { orden: number; ruta: string }> = {
  'Porsche 356':   { orden: 1, ruta: 'ocasion-356' },
  'Porsche 911 F': { orden: 2, ruta: 'ocasion-911' },
  'Porsche 911 G': { orden: 3, ruta: 'ocasion-911' },
  'Porsche 964':   { orden: 4, ruta: 'ocasion-964' },
  'Porsche 993':   { orden: 5, ruta: 'ocasion-993' },
  'Porsche 996':   { orden: 6, ruta: 'ocasion-996' },
  'Porsche 997':   { orden: 7, ruta: 'ocasion-997' },
  'Porsche 991':   { orden: 8, ruta: 'ocasion-991' },
};
const ICONOS = home.secciones
  .filter((s) => s.titulo in GENERACIONES)
  .map((s) => ({
    nombre: s.titulo.replace(/^Porsche /, ''),
    texto: sinHtml(s.parrafos[0] ?? ''),
    foto: s.imagenes[0]?.url,
    ...GENERACIONES[s.titulo],
  }))
  .sort((a, b) => a.orden - b.orden);

const HERRAMIENTAS = [
  { id: 'calculadora-ims', nombre: t('herr.ims.nombre'),
    para: t('herr.ims.para'), cta: 'Calcular',
    texto: 'Con el modelo y el año te dice qué rodamiento IMS puede llevar tu Porsche, qué incidencia tiene y qué hace falta para confirmarlo.',
    foto: '/img/paginas/42e247b6-taller_ims_porsche_reparacion.jpg',
    alt: 'Reparación del rodamiento IMS de un Porsche en el taller' },
  { id: 'evaluador-bore-scoring', nombre: t('herr.bs.nombre'),
    para: t('herr.bs.para'), cta: 'Evaluar',
    texto: 'Valora si tu motor es propenso al rayado de cilindros y si sus síntomas justifican una boroscopia.',
    foto: '/img/paginas/2644ddba-bore_scoring.jpg',
    alt: 'Cilindro de un motor Porsche revisado por bore scoring' },
];

/* Los colores que usa Google para el avatar con inicial */
const AVATARES = ['#E8710A', '#1A73E8', '#0B8043', '#8430CE', '#D93025', '#00897B'];

const MARQUESINA = ['Taller mecánico', 'Restauración', 'Preparación', 'Personalización', 'Sala de motores', 'Porsche en venta'];
---
<Base
  idioma={idioma}
  rutaId="home"
  idiomasPublicados={['es']}
  titulo="Taller Porsche en Barcelona y Madrid · Valentín Motors"
  descripcion="Especialistas Porsche desde 1979. Mantenimiento a precio cerrado, sala de motores, restauración y venta de Porsche de colección, en Barcelona y Madrid."
  imagen="/img/paginas/47048331-taller01.jpg"
>
  <NegocioLocal slot="head" centro="ambos" />
  {/* Marca el documento antes del primer pintado: asi el titulo del hero
      espera a GSAP en vez de verse, ocultarse y volver a entrar. Si el script
      no llega, el CSS lo muestra igual a los 2,5 s. */}
  <script slot="head" is:inline>document.documentElement.classList.add('home-js')</script>
  <Nav slot="nav" idioma={idioma} rutaId="home" idiomasPublicados={['es']} />
  <Pie slot="pie" idioma={idioma} rutaId="home" idiomasPublicados={['es']} />

  <Hero
    clase="hero--home"
    titulo="Especialistas Porsche<br>desde 1979."
    claim="Damos nueva vida al legado Porsche combinando artesanía, excelencia y pasión."
    imagen="/video/home/hero.jpg"
    video="/video/home/hero.mp4"
    scrollLabel={t('scroll')}
    parallax={0.22}
    sinReveal
  />

  {/* ── 1. Quienes somos ── */}
  <section class="seccion nosotros" id="nosotros">
    <div class="contenedor">
      <CabeceraSeccion etiqueta="Quiénes somos" titulo="Taller Porsche independiente" destacado="en Barcelona y Madrid." />
      <p class="nosotros-manifiesto" data-palabras>
        Desde 1979 solo trabajamos con Porsche. Mantenemos, reparamos, restauramos
        y preparamos todas sus generaciones en dos talleres propios, con sala de
        motores. Y vendemos una selección de coches que conocemos por dentro.
      </p>
    </div>
  </section>

  <div class="marquesina" aria-hidden="true">
    <div class="marquesina-pista">
      {[0, 1].map(() => (
        <span class="marquesina-grupo">
          {MARQUESINA.map((m) => <span class="marquesina-item">{m}<i></i></span>)}
        </span>
      ))}
    </div>
  </div>

  {/* ── 2. Que hacemos: en escritorio se recorre en horizontal ── */}
  <section class="servicios-h" id="servicios">
    <div class="servicios-h-pista">
      <div class="servicios-h-intro">
        <CabeceraSeccion etiqueta="Qué hacemos" titulo="Todo lo que un Porsche" destacado="necesita en su vida." />
        <p class="servicios-h-entradilla">
          Cuatro oficios bajo el mismo techo y con el mismo equipo. El coche no
          cambia de manos entre el elevador, la cabina de pintura y el circuito.
        </p>
        <span class="servicios-h-pista-aviso" aria-hidden="true">Desliza &rarr;</span>
      </div>
      {SERVICIOS.map((s, i) => (
        <a class="srv" href={url(s.id, idioma)}>
          <div class="srv-foto">
            <img src={s.foto} alt={s.alt} loading="lazy" decoding="async">
          </div>
          <div class="srv-cuerpo">
            <span class="srv-num">0{i + 1} / 04</span>
            <h3 class="srv-titulo">{s.titulo}</h3>
            <p class="srv-texto">{s.texto}</p>
            <span class="enlace-mono">Ver servicio &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* ── 3. Por que nosotros: puntos fuertes y cifras ── */}
  <section class="seccion propuesta" id="propuesta">
    <div class="contenedor">
      <div class="nosotros-pilares">
        {PILARES.map((p, i) => (
          <div class="pilar" data-entra>
            <span class="pilar-num">0{i + 1}</span>
            <h3 class="pilar-titulo">{p.titulo}</h3>
            <p class="pilar-texto">{p.texto}</p>
          </div>
        ))}
      </div>
      <dl class="cifras">
        {CIFRAS.map((c) => (
          <div class="cifra" data-entra>
            <dt class="cifra-texto">{c.texto}</dt>
            <dd class="cifra-valor">
              <span class="count-up" data-target={c.valor} data-agrupar>
                {new Intl.NumberFormat('es', { useGrouping: 'always' } as Intl.NumberFormatOptions).format(c.valor)}
              </span>
              <span class="cifra-unidad">{c.unidad}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ── 4. Coches en venta, en vivo ── */}
  <section class="seccion kit" id="venta">
    <div class="contenedor">
      <div class="kit-header">
        <CabeceraSeccion etiqueta="En venta" destacado="Porsche en venta." />
        <a class="enlace-mono" href={url('coches', idioma)}>Ver todos &rarr;</a>
      </div>
      <div class={`cars-grid cars-grid--home cars-grid--n${enVenta.length}`}>
        {enVenta.map((c) => (
          <a class={`car-card ${c.catalogo!.estado}`} data-tilt
             href={url('coches', idioma, c.slug)}>
            <div class="car-img-wrap">
              <span class={`car-status-badge badge-${c.catalogo!.estado}`}>
                {c.catalogo!.estadoTexto}
              </span>
              <img src={c.catalogo!.imagen} alt={`${c.catalogo!.marca} ${c.catalogo!.nombre}`}
                   width={c.catalogo!.imagenAncho} height={c.catalogo!.imagenAlto}
                   loading="lazy" decoding="async">
            </div>
            <div class="car-body">
              <p class="car-make">{c.catalogo!.marca}</p>
              <p class="car-name">{c.catalogo!.nombre}</p>
              <p class="car-year">{c.catalogo!.detalle}</p>
              <div class="car-footer">
                <span class={`car-price${c.catalogo!.estado === 'reservado' ? ' tachado' : ''}`}>
                  {c.catalogo!.precio}
                </span>
                <span class="car-cta">{t('cta.ficha')} &rarr;</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── 5. Resenas de Google ── */}
  <section class="seccion opiniones" id="opiniones">
    <div class="contenedor">
      <div class="kit-header">
        <CabeceraSeccion etiqueta="Opiniones" titulo="Lo que dicen" destacado="quienes ya nos conocen." />
        <div class="google-resumen">
          <svg class="google-resumen-g" viewBox="0 0 48 48" aria-hidden="true"><use href="#logo-google" /></svg>
          <span class="google-resumen-nota">{GOOGLE_NOTA.media.toLocaleString('es')}</span>
          <span class="google-resumen-estrellas" role="img"
                aria-label={`${GOOGLE_NOTA.media.toLocaleString('es')} de 5 estrellas`}
                style={`--relleno:${(GOOGLE_NOTA.media / 5) * 100}%`}>
            <span>{[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 20 20" aria-hidden="true"><use href="#estrella" /></svg>)}</span>
            <span>{[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 20 20" aria-hidden="true"><use href="#estrella" /></svg>)}</span>
          </span>
          <a class="google-resumen-total" href={GOOGLE_FICHA} target="_blank" rel="noopener">{GOOGLE_NOTA.total} reseñas en Google</a>
        </div>
        <div class="carrusel-botones">
          <button class="carrusel-boton" type="button" data-carrusel="anterior" aria-label="Reseña anterior">&larr;</button>
          <button class="carrusel-boton" type="button" data-carrusel="siguiente" aria-label="Reseña siguiente">&rarr;</button>
        </div>
      </div>
    </div>
    <div class="opiniones-pista" tabindex="0" role="region" aria-label="Reseñas de Google" data-carrusel-pista>
      {RESENAS.map((r, i) => (
        <article class="resena">
          <header class="resena-cabecera">
            <span class="resena-avatar" style={`--avatar:${AVATARES[i % AVATARES.length]}`} aria-hidden="true">
              {r.autor.trim()[0].toUpperCase()}
            </span>
            <span class="resena-quien">
              <span class="resena-autor">{r.autor}</span>
              {r.meta && <span class="resena-meta">{r.meta}</span>}
            </span>
            <svg class="resena-g" viewBox="0 0 48 48" role="img" aria-label="Reseña de Google"><use href="#logo-google" /></svg>
          </header>
          <div class="resena-nota">
            <span class="estrellas-g" role="img" aria-label="5 de 5 estrellas">
              {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 20 20" aria-hidden="true"><use href="#estrella" /></svg>)}
            </span>
            <span class="resena-fecha">{haceCuanto(r.fecha)}</span>
          </div>
          <p class="resena-texto" lang={r.idioma}>
            {r.texto}{r.truncada && <>&hellip; <a class="resena-mas" href={GOOGLE_FICHA} target="_blank" rel="noopener">Más</a></>}
          </p>
          {r.respondida && <p class="resena-respuesta">Respuesta del propietario</p>}
        </article>
      ))}
    </div>
    <div class="contenedor resenas-pie">
      <a class="cta cta--linea" href={GOOGLE_FICHA} target="_blank" rel="noopener">Ver todas en Google &nearr;</a>
    </div>
    {/* Simbolos compartidos por todas las tarjetas */}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="estrella" viewBox="0 0 20 20"><path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z" /></symbol>
      <symbol id="logo-google" viewBox="0 0 48 48">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </symbol>
    </svg>
  </section>

  {/* ── 6. Centros ── */}
  <section class="seccion" id="centros">
    <div class="contenedor">
      <CabeceraSeccion etiqueta="Dónde estamos" titulo="Dos centros," destacado="un mismo criterio." />
      <div class="centros">
        {CENTROS.map((c) => (
          <a class="centro" href={url(c.id, idioma)}>
            <div class="centro-foto" data-cortina>
              <img src={c.foto} alt={`Taller Valentin Motors ${c.nombre}`}
                   loading="lazy" decoding="async">
            </div>
            <div class="centro-cuerpo">
              <h3 class="centro-nombre">{c.nombre}</h3>
              <p class="centro-dir">{c.direccion}</p>
              <p class="centro-detalle">{c.detalle}</p>
              <dl class="centro-datos">
                <dt>Teléfono</dt><dd>{c.telefono}</dd>
                <dt>Horario</dt><dd>{c.horario}</dd>
              </dl>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── 7. Redes ── */}
  <section class="seccion redes" id="instagram">
    <div class="contenedor">
      <div class="kit-header">
        <CabeceraSeccion etiqueta="Instagram" titulo="Síguenos en Instagram:" destacado="el taller, en vídeo." />
        <a class="enlace-mono" href="https://www.instagram.com/valentinmotors" target="_blank" rel="noopener">@valentinmotors &nearr;</a>
      </div>
      {/* Carrusel circular: seis tarjetas en anillo, la del centro reproduce
          su fragmento y al acabar gira a la siguiente. Sin JS es una fila
          deslizable. */}
      <div class="reels" data-anillo tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Vídeos de Instagram">
        {REELS.map((r) => (
          <a class="reel" href={`https://www.instagram.com/p/${r.id}/`} target="_blank" rel="noopener"
             aria-label={`${r.titulo}: ver el vídeo completo en Instagram`}>
            <video class="reel-video" muted playsinline preload="none"
                   poster={`/video/home/instagram-${r.id}.jpg`}
                   data-src={`/video/home/instagram-${r.id}.mp4`} aria-hidden="true"></video>
            <span class="reel-velo"></span>
            <span class="reel-cuerpo">
              <span class="reel-titulo">{r.titulo}</span>
              <span class="reel-texto">{r.texto}</span>
              <span class="reel-enlace">Ver en Instagram &nearr;</span>
            </span>
            <span class="reel-progreso" aria-hidden="true"><i></i></span>
          </a>
        ))}
      </div>
      <div class="reels-mandos">
        <button class="carrusel-boton" type="button" data-anillo-ir="-1" aria-label="Vídeo anterior">&larr;</button>
        <button class="carrusel-boton" type="button" data-anillo-ir="1" aria-label="Vídeo siguiente">&rarr;</button>
      </div>
    </div>
  </section>

  {/* ── 8. Magazine, en vivo ── */}
  <section class="seccion" id="magazine">
    <div class="contenedor">
      <div class="kit-header">
        <CabeceraSeccion etiqueta="Magazine" titulo="Artículos para conocer" destacado="mejor tu Porsche." />
        <a class="enlace-mono" href={url('magazine', idioma)}>Ver todos &rarr;</a>
      </div>
      <ListaMagazine posts={posts} idioma={idioma} columnas={3}
                     urgentes={0} clase="mag-lista--home mag-lista--azar" />
    </div>
  </section>

  {/* ── 9. Herramientas: solo el gancho, el calculo vive en su pagina ── */}
  <section class="seccion herramientas-home" id="herramientas">
    <div class="contenedor">
      <div class="kit-header">
        <CabeceraSeccion etiqueta="Herramientas" titulo="Antes de venir," destacado="mide el riesgo de tu motor." />
        <a class="enlace-mono" href={url('herramientas', idioma)}>Ver herramientas &rarr;</a>
      </div>
      <div class="herr-home">
        {HERRAMIENTAS.map((h) => (
          <a class="herr-tarjeta" href={url(h.id, idioma)}>
            <span class="herr-tarjeta-foto"><img src={h.foto} alt={h.alt} loading="lazy" decoding="async"></span>
            <span class="herr-tarjeta-cuerpo">
              <span class="herr-tarjeta-nombre">{h.nombre}</span>
              <span class="herr-tarjeta-texto">{h.texto}</span>
              <span class="herr-tarjeta-para">{h.para}</span>
              <span class="cta herr-tarjeta-cta">{h.cta} &rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── 10. Generaciones ── */}
  {ICONOS.length > 0 && (
    <section class="seccion modelos" id="iconos">
      <div class="contenedor">
        <div class="kit-header">
          <CabeceraSeccion etiqueta="Ocho generaciones" titulo="Los modelos que" destacado="conocemos de memoria." />
          <span class="modelos-aviso" aria-hidden="true">Arrastra &rarr;</span>
        </div>
      </div>
      <div class="modelos-pista" tabindex="0" role="region" aria-label="Generaciones de Porsche" data-arrastrable>
        {ICONOS.map((m, i) => (
          <a class="modelo" href={url(m.ruta, idioma)}>
            <span class="modelo-num">{String(i + 1).padStart(2, '0')}</span>
            {m.foto && (
              <img class="modelo-foto" src={m.foto} alt={`Perfil del Porsche ${m.nombre}`}
                   loading="lazy" decoding="async" draggable="false">
            )}
            <span class="modelo-nombre">{m.nombre}</span>
            <span class="modelo-texto">{m.texto}</span>
            <span class="modelo-enlace">Porsche {m.nombre} de segunda mano &rarr;</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* ── 11. Cita ── */}
  <section class="closing cita" id="cita">
    <div class="closing-bg" data-fondo="/img/ruf/exterior3.jpg"
         style="background-image:url('/img/ruf/exterior3.jpg')"></div>
    <div class="closing-overlay"></div>
    <div class="closing-content">
      <p class="section-label">Pide cita</p>
      <h2 class="cita-titulo" data-titular>Cuéntanos qué necesita tu Porsche.</h2>
      <p class="cita-texto">
        Revisión, una avería, una restauración o un coche que quieres comprar.
        Te llamamos para concretar día y hora.
      </p>
      <div class="cita-acciones">
        <a class="cta" href={url('contacto', idioma)} data-magnetico>Pide cita</a>
      </div>
      <p class="cita-telefonos">
        {CENTROS.map((c) => (
          <a href={`tel:${c.tel}`}>{c.nombre} · {c.telefono}</a>
        ))}
      </p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home';
</script>
