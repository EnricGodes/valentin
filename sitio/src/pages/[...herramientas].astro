---
/**
 * Indice de herramientas, en los seis idiomas.
 *
 * La lista se declara aqui, no en el menu. Las dos comparten armazon visual
 * (`.herr-*` en system.css) pero no motor de decision: el IMS clasifica una
 * pieza de fabrica y el bore scoring valora un dano adquirido, y mezclarlos
 * en una sola nota de "salud del motor" seria decir algo que no se sabe.
 */
import { IDIOMAS, type Idioma } from '../i18n/config';
import { url } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Pie from '../components/Pie.astro';

export function getStaticPaths() {
  return IDIOMAS.map((idioma) => ({
    params: { herramientas: url('herramientas', idioma).replace(/^\//, '') },
    props: { idioma },
  }));
}
const { idioma } = Astro.props as { idioma: Idioma };
const t = traductor(idioma);

const herramientas = [
  { id: 'calculadora-ims', nombre: t('herr.ims.nombre'), eyebrow: t('herr.ims.eyebrow'),
    descripcion: t('herr.ims.descripcion'), para: t('herr.ims.para') },
  { id: 'evaluador-bore-scoring', nombre: t('herr.bs.nombre'), eyebrow: t('herr.bs.eyebrow'),
    descripcion: t('herr.bs.descripcion'), para: t('herr.bs.para') },
];
---
<Base
  idioma={idioma}
  rutaId="herramientas"
  idiomasPublicados={IDIOMAS}
  titulo={t('herr.titulo')}
  descripcion={t('herr.descripcion')}
>
  <Nav slot="nav" idioma={idioma} rutaId="herramientas" idiomasPublicados={IDIOMAS} />
  <Pie slot="pie" idioma={idioma} rutaId="herramientas" idiomasPublicados={IDIOMAS} />

  <header class="post-reja mag-cabecera">
    <h1 class="mag-titulo ancha reveal">
      <em>Valentin Motors</em>
      {t('nav.herramientas')}
    </h1>
  </header>

  <div class="post-reja">
    <div class="herramientas ancha">
      {herramientas.map((h) => (
        <a class="herramienta reveal" href={url(h.id, idioma)}>
          <p class="mag-meta">{h.eyebrow}</p>
          <h2 class="herramienta-nombre">{h.nombre}</h2>
          <p class="herramienta-desc">{h.descripcion}</p>
          <p class="herramienta-para">{h.para}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
