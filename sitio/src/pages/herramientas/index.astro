---
/**
 * Indice de herramientas.
 *
 * La lista se declara aqui, no en el menu. Las dos comparten armazon visual
 * (`.herr-*` en system.css) pero no motor de decision: el IMS clasifica una
 * pieza de fabrica y el bore scoring valora un dano adquirido, y mezclarlos
 * en una sola nota de "salud del motor" seria decir algo que no se sabe.
 */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Pie from '../../components/Pie.astro';
import { url } from '../../i18n/routes';

const idioma = 'es' as const;

const herramientas = [
  {
    id: 'calculadora-ims',
    nombre: 'Calculadora IMS Porsche',
    eyebrow: 'Diagnóstico orientativo',
    descripcion: 'Comprueba, a partir del modelo y el año, qué tipo de rodamiento del eje intermedio puede montar tu Porsche, cuál es su incidencia relativa y qué hace falta para confirmarlo.',
    para: '911 996 y 997.1 · Boxster 986 y 987.1 · Cayman 987.1',
  },
  {
    id: 'evaluador-bore-scoring',
    nombre: 'Evaluador de bore scoring Porsche',
    eyebrow: 'Susceptibilidad e indicios',
    descripcion: 'Comprueba la susceptibilidad de tu motor al rayado de cilindros y valora si sus síntomas o sus pruebas justifican una boroscopia. No diagnostica: separa lo que se sabe de esa familia de motores de lo que se sabe de tu unidad.',
    para: '911 desde el 996 · Boxster y Cayman · Cayenne, Panamera y Macan con motor identificable',
  },
];
---
<Base
  idioma={idioma}
  rutaId="herramientas"
  idiomasPublicados={['es']}
  titulo="Herramientas · Valentin Motors"
  descripcion="Herramientas de consulta para propietarios de Porsche, hechas por los especialistas de Valentin Motors."
>
  <Nav slot="nav" idioma={idioma} rutaId="herramientas" idiomasPublicados={['es']} />
  <Pie slot="pie" idioma={idioma} rutaId="herramientas" idiomasPublicados={['es']} />

  <header class="post-reja mag-cabecera">
    <h1 class="mag-titulo ancha reveal">
      <em>Valentin Motors</em>
      Herramientas
    </h1>
  </header>

  <div class="post-reja">
    <div class="herramientas ancha">
      {herramientas.map((h) => (
        <a class="herramienta reveal" href={url(h.id, idioma)}>
          <p class="mag-meta">{h.eyebrow}</p>
          <h2 class="herramienta-nombre">{h.nombre}</h2>
          <p class="herramienta-desc">{h.descripcion}</p>
          <p class="herramienta-para">{h.para}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
