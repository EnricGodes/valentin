---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Pie from '../../components/Pie.astro';
import { url } from '../../i18n/routes';
import { traductor } from '../../i18n/ui';
import Articulo from '../../components/seo/Articulo.astro';
import Migas from '../../components/seo/Migas.astro';
import Faq from '../../components/seo/Faq.astro';
import CalculadoraIms from '../../components/CalculadoraIms.astro';
import { DOMINIO } from '../../i18n/config';
import type { Idioma } from '../../i18n/config';

/* Esta ruta sirve el espanol, que vive en la raiz. Los demas idiomas los
   genera src/pages/[lang]/magazine/[slug].astro. */
export async function getStaticPaths() {
  const posts = await getCollection('magazine', (p) => p.data.lang === 'es');
  const todos = await getCollection('magazine');
  return posts.map((post) => ({
    params: { slug: post.data.slugFinal },
    props: {
      post,
      // Solo los idiomas en los que el post existe de verdad
      idiomas: todos.filter((p) => p.data.slugFinal === post.data.slugFinal)
        .map((p) => p.data.lang as Idioma),
    },
  }));
}

const { post, idiomas } = Astro.props;
const { Content } = await render(post);
const idioma = 'es' as const;
const t = traductor(idioma);

const fecha = new Intl.DateTimeFormat('es', { dateStyle: 'long' }).format(post.data.date);
const limpio = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

/* La foto de apertura sube a la portada a sangre. Se coge solo si el articulo
   EMPIEZA por una foto suelta (33 de los 42): asi coincide con la que
   rehype-editorial oculta en el cuerpo y nadie la ve dos veces. Los nueve que
   abren con texto o con una galeria llevan portada tipografica. */
const cuerpoMd = (post.body ?? '').trim();
const abre = /^!\[[^\]]*\]\(([^)\s]+)/.exec(cuerpoMd.split(/\n\s*\n/)[0].trim());
const heroFoto = abre?.[1];
const portada = heroFoto ?? cuerpoMd.match(/!\[[^\]]*\]\(([^)\s]+)/)?.[1];
/* Herramientas incrustadas en el articulo. El cuerpo deja el hueco con la
   directiva `:::herramienta` y el script mueve el componente hasta el. Se
   declara aqui, y no en el Markdown, porque el componente es de Astro. */
const llevaCalculadoraIms = (post.body ?? '').includes('herramienta{id="calculadora-ims"}');

const descripcion = limpio(post.data.excerpt).slice(0, 300)
  || `${post.data.title} · Magazine de Valentin Motors.`;
---
<Base
  idioma={idioma}
  rutaId="magazine"
  extra={[post.data.slugFinal]}
  idiomasPublicados={idiomas}
  titulo={post.data.metaTitulo ?? `${post.data.title} · Valentin Motors`}
  descripcion={post.data.metaDescripcion ?? descripcion}
>
  <Fragment slot="head">
    <Articulo titulo={post.data.title}
              descripcion={post.data.metaDescripcion ?? limpio(post.data.excerpt).slice(0, 300)}
              fecha={post.data.date} autor={post.data.author}
              url={DOMINIO + url('magazine', idioma, post.data.slugFinal)}
              imagen={portada} idioma={idioma} />
    <Migas idioma={idioma} migas={[
      { nombre: 'Magazine', rutaId: 'magazine' },
      { nombre: post.data.title, rutaId: 'magazine', extra: [post.data.slugFinal] },
    ]} />
    <Faq markdown={post.body ?? ''}
         url={DOMINIO + url('magazine', idioma, post.data.slugFinal)} idioma={idioma} />
  </Fragment>
  <Nav slot="nav" idioma={idioma} rutaId="magazine" extra={[post.data.slugFinal]}
       idiomasPublicados={idiomas} />
  <Pie slot="pie" idioma={idioma} rutaId="magazine" extra={[post.data.slugFinal]} idiomasPublicados={idiomas} />

  <article class="post">
    <div class="post-progreso" data-progreso></div>

    <header class:list={['post-portada', !heroFoto && 'post-portada--texto']}>
      {heroFoto && (
        <div class="post-portada-foto">
          <img src={heroFoto} alt="" fetchpriority="high" decoding="async">
        </div>
      )}

      <div class="post-portada-texto">
        <p class="post-eyebrow reveal">
          {post.data.categories.map((c, i) => (
            <>{i > 0 && ' · '}<a href={url('magazine', idioma, 'category', c)}>{c}</a></>
          ))}
        </p>
        <h1 class="post-title reveal delay-1">{post.data.title}</h1>
      </div>

      <dl class="post-credito reveal delay-3">
        <div>
          <dt>{t('post.fecha')}</dt>
          <dd><time datetime={post.data.date.toISOString()}>{fecha}</time></dd>
        </div>
        {post.data.categories.length > 0 && (
          <div>
            <dt>{t('post.seccion')}</dt>
            <dd><a href={url('magazine', idioma, 'category', post.data.categories[0])}>
              {post.data.categories[0]}</a></dd>
          </div>
        )}
        {post.data.author && (
          <div><dt>{t('post.texto')}</dt><dd>{post.data.author}</dd></div>
        )}
      </dl>
    </header>

    {post.data.excerpt && (
      <div class="post-reja">
        <p class="post-entradilla ancha reveal">{limpio(post.data.excerpt)}</p>
      </div>
    )}

    <div class="post-cuerpo"><Content /></div>

    <script>
      import { iniciarModulos } from '../../scripts/modulos.ts';
      iniciarModulos();
    </script>

    {llevaCalculadoraIms && (
      <div class="post-reja ims-envoltorio">
        <div class="ancha"><CalculadoraIms compacta /></div>
      </div>
    )}

    <div class="post-reja">
      {post.data.ctas.length > 0 && (
        <div class="post-ctas">
          {post.data.ctas.map((c) => <a class="cta" href={c.href}>{c.texto}</a>)}
        </div>
      )}
      <footer class="post-pie">
        <a class="post-volver" href={url('magazine', idioma)}>&larr; {t('post.volver')}</a>
      </footer>
    </div>
  </article>
</Base>
