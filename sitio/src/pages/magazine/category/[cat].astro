---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Pie from '../../../components/Pie.astro';
import ListaMagazine from '../../../components/ListaMagazine.astro';
import { url } from '../../../i18n/routes';

export async function getStaticPaths() {
  const posts = await getCollection('magazine', (p) => p.data.lang === 'es');
  const cats = new Map<string, typeof posts>();
  for (const p of posts) {
    for (const c of p.data.categories) {
      cats.set(c, [...(cats.get(c) ?? []), p]);
    }
  }
  return [...cats].map(([cat, lista]) => ({
    params: { cat },
    props: {
      cat,
      posts: lista.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
      secciones: [...cats.keys()].sort(),
    },
  }));
}

const { cat, posts, secciones } = Astro.props;
const idioma = 'es' as const;
---
<Base
  idioma={idioma}
  rutaId="magazine"
  extra={['category', cat]}
  idiomasPublicados={['es']}
  titulo={`${cat} · Magazine · Valentin Motors`}
  descripcion={`Articulos de la categoria ${cat} en el Magazine de Valentin Motors.`}
>
  <Nav slot="nav" idioma={idioma} rutaId="magazine" idiomasPublicados={['es']} />
  <Pie slot="pie" idioma={idioma} />

  <header class="post-reja mag-cabecera">
    <h1 class="mag-titulo ancha reveal">
      <em>Magazine</em>
      {cat}
    </h1>
    <nav class="mag-filtros ancha reveal delay-1">
      <span>{posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}</span>
      <a href={url('magazine', idioma)}>Todos</a>
      {secciones.map((c) => (
        <a href={url('magazine', idioma, 'category', c)}
           aria-current={c === cat ? 'page' : undefined}>{c}</a>
      ))}
    </nav>
  </header>

  <div class="post-reja">
    {/* Sin pieza destacada: aqui ya se ha elegido seccion, y destacar una
        dentro de la eleccion vuelve a decidir por quien ya decidio. */}
    <ListaMagazine posts={posts} idioma={idioma} columnas={2} urgentes={4} />
  </div>
</Base>
