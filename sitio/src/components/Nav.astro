---
import { IDIOMAS, type Idioma } from '../i18n/config';
import { url } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import SelectorIdioma from './SelectorIdioma.astro';

interface Props {
  idioma: Idioma;
  rutaId: string;
  extra?: string[];
  /** Idiomas en los que ESTA pagina existe. El selector no puede ofrecer un
      idioma sin traducir: seria un enlace a un 404. */
  idiomasPublicados?: readonly Idioma[];
}
const { idioma, rutaId, extra = [], idiomasPublicados = IDIOMAS } = Astro.props;
const t = traductor(idioma);

const enlaces = [
  { id: 'coches', texto: t('nav.coches') },
  { id: 'taller', texto: t('nav.taller') },
  { id: 'restauraciones', texto: t('nav.servicios') },
  { id: 'magazine', texto: t('nav.magazine') },
  // Las herramientas solo existen en castellano por ahora. Enlazarlas desde el
  // menu aleman seria ofrecer un 404 en el sitio principal.
  ...(idioma === 'es' ? [{ id: 'herramientas', texto: t('nav.herramientas') }] : []),
  { id: 'quienes-somos', texto: t('nav.nosotros') },
  { id: 'contacto', texto: t('nav.contacto') },
];
---
<nav class="nav">
  <a class="nav-brand" href={url('home', idioma)}>Valentin<span>Motors</span></a>
  <ul class="nav-links">
    {enlaces.map((e) => (
      <li>
        <a href={url(e.id, idioma)}
           aria-current={e.id === rutaId ? 'page' : undefined}>{e.texto}</a>
      </li>
    ))}
  </ul>
  <SelectorIdioma idioma={idioma} rutaId={rutaId} extra={extra}
                  idiomasPublicados={idiomasPublicados} />
</nav>
