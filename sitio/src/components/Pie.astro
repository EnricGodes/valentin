---
import type { Idioma } from '../i18n/config';
import { url } from '../i18n/routes';
import { traductor } from '../i18n/ui';

interface Props { idioma: Idioma; }
const { idioma } = Astro.props;
const t = traductor(idioma);
const anio = new Date().getFullYear();
---
<footer class="pie">
  <p class="footer-brand">Valentin<span>Motors</span> &middot; {t('footer.desde')}</p>
  <p class="footer-copy">
    <a href={url('aviso-legal', idioma)}>Legal</a> &middot;
    <a href={url('privacidad', idioma)}>Privacidad</a> &middot;
    VM German Engineering, S.L. &copy; {anio}
  </p>
</footer>
