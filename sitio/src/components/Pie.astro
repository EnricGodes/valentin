---
import { IDIOMAS, POR_DEFECTO, type Idioma } from '../i18n/config';
import { url } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import SelectorIdioma from './SelectorIdioma.astro';

interface Props {
  idioma: Idioma;
  /* El selector baja aqui desde la barra: con el idioma detectandose solo, el
     cambio manual es la excepcion, y el pie es donde se busca. Necesita saber
     en que pagina esta para ofrecer la misma en otro idioma, y en cuales
     existe: ofrecer un idioma sin traducir es enlazar a un 404. */
  rutaId?: string;
  extra?: string[];
  idiomasPublicados?: readonly Idioma[];
}
const { idioma, rutaId = 'home', extra = [], idiomasPublicados = IDIOMAS } = Astro.props;
const t = traductor(idioma);
const anio = new Date().getFullYear();

/* Las paginas legales existen SOLO en espanol: son textos juridicos bajo ley
   espanola y la version vinculante es esa. Por eso el pie enlaza siempre al
   espanol, con lang="es" para que el navegador y el lector de pantalla sepan
   en que idioma esta lo que hay al otro lado. Enlazar a /en/legal-notice era
   enlazar a un 404. */
const legal = (id: string) => url(id, POR_DEFECTO);
const otroIdioma = idioma !== POR_DEFECTO;
---
<footer class="pie">
  <SelectorIdioma idioma={idioma} rutaId={rutaId} extra={extra}
                  idiomasPublicados={idiomasPublicados} />
  <p class="footer-brand">Valentin<span>Motors</span> &middot; {t('footer.desde')}</p>
  <p class="footer-copy">
    <a href={legal('aviso-legal')} lang="es" hreflang="es">{t('pie.legal')}</a> &middot;
    <a href={legal('privacidad')} lang="es" hreflang="es">{t('pie.privacidad')}</a> &middot;
    <a href={legal('cookies')} lang="es" hreflang="es">{t('pie.cookies')}</a>
    {otroIdioma && <span class="footer-nota">({t('pie.soloEspanol')})</span>}
    &middot; VM German Engineering, S.L. &copy; {anio}
  </p>
</footer>
<style>
  .footer-nota { opacity: .65; }
</style>
