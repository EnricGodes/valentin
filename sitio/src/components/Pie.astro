---
/**
 * Pie de página común.
 *
 * Es la segunda navegación del sitio: quien llega a un artículo desde Google y
 * quiere saber quién lo escribe termina aquí abajo, no arriba. Por eso lleva
 * las cinco cosas que se buscan al final de una página: dónde estáis, qué más
 * hay, en qué idioma, dónde os sigo y quiénes sois.
 *
 * Las secciones madre salen del manifiesto y solo se pintan si existen en este
 * idioma, igual que en el menú: enlazar a lo que no está traducido es ofrecer
 * un 404 desde el pie de todas las páginas.
 */
import { IDIOMAS, POR_DEFECTO, type Idioma } from '../i18n/config';
import { url } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import { idiomasDe, paginaPorRuta } from '../datos/pagina';
import { CENTROS } from '../datos/centros';
import { idiomasConCatalogo } from '../datos/coche';
import { FAMILIAS, enlaceLanding } from '../datos/generacion';
import SelectorIdioma from './SelectorIdioma.astro';

interface Props {
  idioma: Idioma;
  rutaId?: string;
  extra?: string[];
  idiomasPublicados?: readonly Idioma[];
}
const { idioma, rutaId = 'home', extra = [], idiomasPublicados = IDIOMAS } = Astro.props;
const t = traductor(idioma);
const anio = new Date().getFullYear();

/* Las legales existen en los seis idiomas desde octubre de 2026. */
const legal = (id: string) => url(id, idioma);

/* La home y el Magazine viven fuera del manifiesto de contenido, pero
   existen en los seis idiomas, igual que las Herramientas. */
const SEIS_IDIOMAS = new Set(['home', 'magazine']);
const hay = (id: string) =>
  SEIS_IDIOMAS.has(id) ? true
  /* El catalogo no es una pagina de datos/paginas: existe en los idiomas que
     tienen alguna ficha traducida. Sin esto, el menu ingles mandaba al
     catalogo espanol teniendo el suyo. */
  : id === 'coches' ? idiomasConCatalogo().includes(idioma)
  : idiomasDe(id).includes(idioma);

const SECCIONES = ['coches', 'taller', 'restauraciones', 'builds', 'centros',
                   'magazine', 'herramientas', 'quienes-somos', 'contacto'];
const rotulo = (id: string) => {
  const p = paginaPorRuta(id, idioma) ?? paginaPorRuta(id, POR_DEFECTO);
  return p?.menu ?? p?.h1 ?? id;
};
const ETIQUETA: Record<string, string> = {
  coches: t('nav.coches'), taller: t('nav.taller'), restauraciones: t('nav.servicios'),
  builds: t('nav.builds'), centros: t('nav.centros'), magazine: t('nav.magazine'),
  herramientas: t('nav.herramientas'), 'quienes-somos': t('nav.nosotros'),
  contacto: t('nav.contacto'),
};
const secciones = SECCIONES
  .map((id) => ({
    id, texto: ETIQUETA[id] ?? rotulo(id),
    href: url(id, hay(id) ? idioma : POR_DEFECTO),
    lang: hay(id) ? undefined : POR_DEFECTO,
  }));

/* Las landings por generacion, enlazadas desde todas las paginas. Un enlace
   de pie no vale lo que uno de menu, pero es el unico que llega a las 750
   paginas del sitio, y "porsche 997 segunda mano" se busca mucho mas que
   cualquier cosa que haya en el menu. Veintidos en una columna eran un
   listado absurdo: van en cinco lineas por familia, como el indice de un
   catalogo, con el numero como texto y la familia delante para que "997"
   signifique algo. Google lee el <a> igual. */
const FAM: Record<string, string> = {
  '911': t('pie.fam.911'), boxster: t('pie.fam.boxster'), transaxle: t('pie.fam.transaxle'),
  clasicos: t('pie.fam.clasicos'), suv: t('pie.fam.suv'),
};
const familias = FAMILIAS
  .map((f) => ({ id: f.id, texto: FAM[f.id],
                 enlaces: f.generaciones.map((g) => enlaceLanding(g, idioma))
                           .filter((e) => e !== undefined) }))
  .filter((f) => f.enlaces.length > 0);

---
<footer class="pie">
  <div class="pie-rejilla">
    <div class="pie-marca">
      <p class="pie-logo">Valentin<span>Motors</span></p>
      <p class="pie-claim">{t('footer.desde')}</p>
      <a class="pie-social" href="https://www.instagram.com/valentinmotors"
         target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
             stroke="currentColor" stroke-width="1.5">
          <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
        </svg>
        <span>{t('pie.siguenos')}</span>
      </a>
      <SelectorIdioma idioma={idioma} rutaId={rutaId} extra={extra}
                      idiomasPublicados={idiomasPublicados} />
    </div>

    {CENTROS.map((c) => (
      <div class="pie-bloque">
        <p class="pie-titulo">
          {hay(c.rutaId)
            ? <a href={url(c.rutaId, idioma)}>{c.nombre}</a>
            : c.nombre}
        </p>
        <address class="pie-dir">
          {c.calle}<br>{c.ciudad}<br>
          <a href={`tel:${c.telHref}`}>{c.tel}</a><br>
          <a href={`mailto:${c.email}`}>{c.email}</a>
        </address>
        <p class="pie-horario">
          <span class="pie-dias">{t('pie.horario')}</span>
          {c.horas.map((h) => (
            <span class="pie-hora">{h.que === 'taller' ? t('pie.taller') : t('pie.ventas')} {h.cuando}</span>
          ))}
        </p>
      </div>
    ))}

    <nav class="pie-bloque" aria-label={t('pie.secciones')}>
      <p class="pie-titulo">{t('pie.secciones')}</p>
      <ul class="pie-mapa">
        {secciones.map((s) => (
          <li><a href={s.href} lang={s.lang} hreflang={s.lang}>{s.texto}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  {familias.length > 0 && (
    <nav class="pie-modelos" aria-label={t('pie.modelos')}>
      <p class="pie-titulo">{t('pie.modelos')}</p>
      <dl class="pie-familias">
        {familias.map((f) => (
          <div class="pie-familia">
            <dt>{f.texto}</dt>
            <dd>
              {f.enlaces.map((e, i) => (
                <>{i > 0 && <span class="pie-sep" aria-hidden="true">·</span>}
                  <a href={e!.href} lang={e!.lang} hreflang={e!.lang}
                     title={e!.nombre}>{e!.corto}</a></>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </nav>
  )}

  <div class="pie-abajo">
    <p class="pie-legal">
      <a href={legal('aviso-legal')}>{t('pie.legal')}</a> &middot;
      <a href={legal('privacidad')}>{t('pie.privacidad')}</a> &middot;
      <a href={legal('cookies')}>{t('pie.cookies')}</a> &middot;
      <a href="#cookies" data-abrir-cookies rel="nofollow">{t('pie.configurarCookies')}</a>
      &middot; VM German Engineering, S.L. &copy; {anio}
    </p>
  </div>
</footer>
