---
/**
 * Medicion del sitio.
 *
 * Dos capas, por una razon: en Espana entre el 20% y el 40% de los visitantes
 * rechaza las cookies, y con GA4 a secas esa gente sencillamente no existe en
 * los informes.
 *
 *   Cloudflare Web Analytics  sin cookies, sin banner, mide al 100%
 *   GA4                       solo tras consentimiento, conserva el historico
 *                             y los key events
 */
interface Props { ga4?: string; cloudflare?: string; }
const {
  ga4 = import.meta.env.PUBLIC_GA4_ID ?? 'G-7BXF6VQQMP',
  cloudflare = import.meta.env.PUBLIC_CF_BEACON ?? '',
} = Astro.props;
---
{cloudflare && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cloudflare}"}`}></script>
)}

<script is:inline define:vars={{ ga4 }}>
  // Consent Mode v2: gtag se configura SIEMPRE, pero arranca denegado. Asi, en
  // cuanto el usuario acepta, no hace falta recargar para empezar a medir.
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { window.dataLayer.push(arguments); };
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
  });

  /* Arranque de GA4, el unico: lo llaman esta pagina si ya habia consentimiento
     y el banner cuando se acepta. Fuera de www.valentinmotors.es (la URL
     temporal de Cloudflare, astro dev) el trafico se marca como interno, y el
     filtro de datos de GA4 lo aparta de los informes. */
  let arrancado = false;
  window.vmIniciarGA = function () {
    if (arrancado) return;
    arrancado = true;
    gtag('consent', 'update', { analytics_storage: 'granted' });
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
    document.head.appendChild(s);
    gtag('js', new Date());
    const interno = location.hostname !== 'www.valentinmotors.es';
    gtag('config', ga4, interno ? { traffic_type: 'internal', debug_mode: true } : {});
  };

  /* Retirar el consentimiento: se deniega y se borran las cookies de GA, que
     de otro modo seguirian ahi hasta caducar. */
  window.vmRetirarGA = function () {
    gtag('consent', 'update', { analytics_storage: 'denied' });
    const dominio = location.hostname.replace(/^www\./, '');
    document.cookie.split(';').map((c) => c.split('=')[0].trim())
      .filter((n) => n === '_ga' || n.startsWith('_ga_'))
      .forEach((n) => {
        for (const d of ['', '; domain=' + dominio, '; domain=.' + dominio]) {
          document.cookie = n + '=; max-age=0; path=/' + d;
        }
      });
  };

  let leido = null;
  try { leido = localStorage.getItem('vm-consentimiento'); } catch (e) { /* modo privado */ }
  if (leido === 'aceptado') window.vmIniciarGA();
</script>
