---
import type { Idioma } from '../i18n/config';
import { POR_DEFECTO } from '../i18n/config';
import { url } from '../i18n/routes';
import { traductor } from '../i18n/ui';

interface Props { idioma: Idioma; }
const { idioma } = Astro.props;
const t = traductor(idioma);
---
{/* Oculto hasta que el script decida: sin esto parpadea en cada carga aunque
    el visitante ya haya decidido hace meses. */}
<div id="cookies" class="cookies" hidden role="dialog" aria-live="polite"
     aria-label={t('cookies.titulo')}>
  <p class="cookies-texto">
    {t('cookies.texto')}
    {' '}
    <a href={url('cookies', POR_DEFECTO)} lang="es" hreflang="es">{t('cookies.masInfo')}</a>
  </p>
  <div class="cookies-botones">
    <button type="button" class="cookies-btn cookies-btn--no" data-cookies="rechazado">
      {t('cookies.rechazar')}
    </button>
    <button type="button" class="cookies-btn cookies-btn--si" data-cookies="aceptado">
      {t('cookies.aceptar')}
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    const CLAVE = 'vm-consentimiento';
    const caja = document.getElementById('cookies');
    if (!caja) return;
    let decidido = null;
    try { decidido = localStorage.getItem(CLAVE); } catch (e) { decidido = 'rechazado'; }
    if (!decidido) caja.hidden = false;

    caja.addEventListener('click', function (e) {
      const b = e.target.closest('[data-cookies]');
      if (!b) return;
      const valor = b.dataset.cookies;
      try { localStorage.setItem(CLAVE, valor); } catch (e) { /* modo privado */ }
      caja.hidden = true;
      if (valor === 'aceptado' && window.gtag) {
        gtag('consent', 'update', { analytics_storage: 'granted' });
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-7BXF6VQQMP';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-7BXF6VQQMP', { anonymize_ip: true });
      }
    });
  })();
</script>
