---
/**
 * Consulta de tarifas de mantenimiento.
 *
 * Antes esto eran seis paginas con 57 acordeones, y para llegar a una cifra
 * habia que acertar que un 997.1 GT3 vive en la pagina "GT" y no en la de
 * "911", abrir uno de veintiun desplegables y leer tres parrafos sobre la
 * importancia del mantenimiento. Los mismos tres parrafos en los 57.
 *
 * Se navega como en el Finder: la familia a la izquierda, sus modelos a la
 * derecha, y debajo la tabla del que se elija. La agrupacion por familia era
 * lo unico que la version de seis paginas hacia bien, porque es como se piensa
 * un Porsche: primero "es un GT", luego "es el 997.1".
 *
 * El contenido se monta en el cliente. Pintar un panel por modelo en el
 * servidor costaba 3,4 KB cada uno: 195 KB de HTML para 7 KB de precios.
 */
import type { Idioma } from '../i18n/config';
import tarifas from '../datos/tarifas.json';

interface Props {
  idioma: Idioma;
  /** Limita a una familia. Sin esto salen las seis. */
  familia?: string;
  textos: { familia: string; modelo: string; nota: string };
}
const { familia, textos } = Astro.props;

const modelos = tarifas.modelos.filter((m) => !familia || m.familia === familia);
const familias = tarifas.familias.filter((f) => modelos.some((m) => m.familia === f.id));

/* Punto de millar tambien en las de cuatro cifras. La norma lo desaconseja
   para 1093, pero esto son precios: en una columna de importes "1.093" se lee
   de un golpe y "1093" hay que contarlo. */
const euros = (n: number) => n.toLocaleString('es-ES').replace(/^(\d)(\d{3})$/, '$1.$2');

const primero = modelos[0];
const datos = modelos.map((m) => ({
  id: m.id,
  n: m.nombre,
  s: m.servicios.map((s) => [s.concepto, s.detalle, euros(s.euros), s.desde ? 1 : 0]),
}));
---
<section class="tarifas ancha" data-tarifas>
  <div class="tarifas-columnas">
    {familias.length > 1 && (
      <div class="tarifas-col">
        <p class="tarifas-col-titulo">{textos.familia}</p>
        <ul class="tarifas-lista" data-tarifas-familias>
          {familias.map((f, i) => (
            <li>
              <button type="button" class="tarifas-opcion" data-familia={f.id}
                      aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.nombre}
                <span class="tarifas-cuenta">
                  {modelos.filter((m) => m.familia === f.id).length}
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="tarifas-col">
      <p class="tarifas-col-titulo">{textos.modelo}</p>
      <ul class="tarifas-lista" data-tarifas-modelos>
        {modelos.map((m, i) => (
          <li data-de={m.familia} hidden={familias.length > 1 && m.familia !== familias[0].id}>
            <button type="button" class="tarifas-opcion" data-modelo={m.id}
                    aria-pressed={i === 0 ? 'true' : 'false'}>{m.nombre}</button>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {/* El primero pintado: es lo que se ve al llegar y lo que queda sin
      JavaScript. Los demas los monta el script con los mismos datos. */}
  <div class="tarifas-panel" data-tarifas-panel aria-live="polite">
    <h3 class="tarifas-panel-titulo">{primero.nombre}</h3>
    <dl class="tarifas-tabla">
      {primero.servicios.map((s) => (
        <div class="tarifas-fila">
          <dt>{s.concepto}{s.detalle && <span class="tarifas-detalle">{s.detalle}</span>}</dt>
          <dd>{s.desde && <span class="tarifas-desde">desde</span>}{euros(s.euros)} €</dd>
        </div>
      ))}
    </dl>
  </div>

  <p class="tarifas-nota">{textos.nota}</p>
  <script type="application/json" data-tarifas-datos set:html={JSON.stringify(datos)} />
</section>
