---
/**
 * Los servicios del taller, todos con el mismo formato: foto panoramica a
 * sangre por la izquierda, el panel con numero y titulo montado sobre la
 * esquina inferior derecha de la foto, y debajo el texto y los botones.
 * Nueve veces el mismo ritmo, que es lo que hace que se lean como una
 * serie y no como una pagina de bloques distintos.
 *
 * Cada bloque corresponde a una entrada del menu del Taller (mas el Storage)
 * y enlaza a esa pagina. El de mantenimiento lleva dentro el resumen de
 * tarifas y no lleva boton propio: el suyo es "Ver todas las tarifas".
 */
import { POR_DEFECTO, type Idioma } from '../i18n/config';
import { url, enlazaEnIdioma } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import { idiomasDe, type ServicioPagina } from '../datos/pagina';
import TarifasResumen from './TarifasResumen.astro';

interface Props { servicios: ServicioPagina[]; idioma: Idioma; }
const { servicios, idioma } = Astro.props;
const t = traductor(idioma);

const enlace = (rutaId: string) => {
  const propio = idiomasDe(rutaId).includes(idioma);
  return { href: url(rutaId, propio ? idioma : POR_DEFECTO), lang: propio ? undefined : POR_DEFECTO };
};
const hrefEn = (href: string) =>
  enlazaEnIdioma(`href="${href}"`, idioma).replace(/^href="|"$/g, '');
---
<section class="svc-lista" aria-label={t('servicios.label')}>
  {servicios.map((s, i) => {
    const e = enlace(s.rutaId);
    const conTarifas = s.rutaId === 'taller-tarifas';
    return (
      <article class="svc" id={s.rutaId}>
        <a class="svc-foto reveal-foto" href={e.href} lang={e.lang} hreflang={e.lang} tabindex="-1" aria-hidden="true">
          <img src={s.foto.url} alt={s.foto.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async">
        </a>
        <div class="svc-cuerpo">
          <div class="svc-panel reveal">
            <p class="svc-numero">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="svc-titulo"><a href={e.href} lang={e.lang} hreflang={e.lang}>{s.titulo}</a></h2>
          </div>
          <div class="svc-texto reveal delay-1">
            <div class="texto-editorial">
              {s.parrafos.map((p) => <p set:html={enlazaEnIdioma(p, idioma)} />)}
            </div>
            {!conTarifas && (
              <div class="svc-acciones">
                <a class="cta" href={e.href} lang={e.lang} hreflang={e.lang}>{t('tarifas.verFamilia')}</a>
                {s.enlace && <a class="cta cta--linea" href={hrefEn(s.enlace.href)}>{s.enlace.texto}</a>}
              </div>
            )}
          </div>
        </div>
        {conTarifas && (
          <div class="svc-anexo">
            <TarifasResumen idioma={idioma} titulo={t('tarifas.resumenTitulo')} />
          </div>
        )}
      </article>
    );
  })}
</section>
