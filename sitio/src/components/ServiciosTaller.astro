---
/**
 * Los servicios del taller, uno a uno, como en la pagina publicada: foto a un
 * lado, texto al otro, y el enlace a la pagina del servicio. Alternan de lado
 * para que nueve bloques seguidos no se lean como una lista.
 *
 * Cada bloque corresponde a una entrada del menu del Taller (mas el Storage,
 * que es servicio del taller aunque cuelgue del menu de Servicios), y el
 * enlace va a esa pagina: antes el CTA de todos era "Solicita una cita" al
 * contacto, y las paginas de cada servicio, que son las que explican y
 * posicionan, no recibian ni un enlace desde aqui.
 *
 * El plan de mantenimiento lleva dentro el resumen de tarifas: son lo mismo
 * y estaban separados.
 */
import { POR_DEFECTO, type Idioma } from '../i18n/config';
import { url, enlazaEnIdioma } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import { idiomasDe, type ServicioPagina } from '../datos/pagina';
import TarifasResumen from './TarifasResumen.astro';

interface Props { servicios: ServicioPagina[]; idioma: Idioma; }
const { servicios, idioma } = Astro.props;
const t = traductor(idioma);

const enlace = (rutaId: string) => {
  const propio = idiomasDe(rutaId).includes(idioma);
  return { href: url(rutaId, propio ? idioma : POR_DEFECTO), lang: propio ? undefined : POR_DEFECTO };
};
/* El "10 cosas..." y los "que es" del Magazine se escriben en castellano y se
   resuelven al idioma al pintar, como cualquier enlace interno. */
const hrefEn = (href: string) =>
  enlazaEnIdioma(`href="${href}"`, idioma).replace(/^href="|"$/g, '');
---
<section class="svc-lista" aria-label={t('servicios.label')}>
  {servicios.map((s, i) => {
    const e = enlace(s.rutaId);
    return (
      <article class:list={['svc', i % 2 ? 'svc--foto-derecha' : 'svc--foto-izquierda']}
               id={s.rutaId}>
        <div class="svc-interior">
          <a class="svc-foto reveal-foto" href={e.href} lang={e.lang} hreflang={e.lang} tabindex="-1" aria-hidden="true">
            <img src={s.foto.url} alt={s.foto.alt} loading={i < 1 ? 'eager' : 'lazy'} decoding="async">
          </a>
          <div class="svc-texto">
            <p class="svc-numero reveal">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="svc-titulo reveal">{s.titulo}</h2>
            <div class="texto-editorial reveal delay-1">
              {s.parrafos.map((p) => <p set:html={enlazaEnIdioma(p, idioma)} />)}
            </div>
            <div class="svc-acciones reveal delay-2">
              <a class="cta" href={e.href} lang={e.lang} hreflang={e.lang}>{t('tarifas.verFamilia')}</a>
              {s.enlace && (
                <a class="enlace-mono" href={hrefEn(s.enlace.href)}>{s.enlace.texto} &rarr;</a>
              )}
            </div>
          </div>
        </div>
        {s.rutaId === 'taller-mantenimiento' && (
          <div class="svc-anexo">
            <TarifasResumen idioma={idioma} titulo={t('tarifas.resumenTitulo')} />
          </div>
        )}
      </article>
    );
  })}
</section>
