---
import type { Idioma } from '../i18n/config';
import { url } from '../i18n/routes';
import { traductor } from '../i18n/ui';
import type { Coche } from '../datos/coche';
import { publicables } from '../datos/pagina';
import { GENERACIONES_CON_LANDING, unidadesDeGeneracion } from '../datos/generacion';
import TarjetaCoche from './TarjetaCoche.astro';

interface Props { coches: Coche[]; idioma: Idioma; }
const { coches, idioma } = Astro.props;
const t = traductor(idioma);

/* Las landings por generacion y la de venta existian sin que nada las
   enlazara: se llegaba a ellas solo desde Google. El catalogo es su sitio,
   porque quien mira coches es quien busca "997 de segunda mano" y quien se
   plantea vender el suyo. Ya no van en el menu: alli cada modelo nuevo era
   una entrada mas, y aqui caben todos. Cada una dice cuantas unidades tiene
   ahora, que es lo que decide si merece el clic. */
const publicadas = publicables().filter((x) => x.idioma === idioma);
const landings = GENERACIONES_CON_LANDING
  .map((g) => ({
    pagina: publicadas.find((x) => x.pagina.rutaId === g.rutaId)?.pagina,
    unidades: unidadesDeGeneracion(g.generacion, idioma).disponibles.length,
  }))
  .filter((l) => l.pagina !== undefined);
const vender = publicadas.find((x) => x.pagina.rutaId === 'vende')?.pagina;

const disponibles = coches.filter((c) => c.catalogo?.estado !== 'vendido').length;
const actualizado = new Intl.DateTimeFormat(idioma, { month: 'long', year: 'numeric' })
  .format(new Date());
---
<header class="page-header">
  <div class="shimmer-line reveal"></div>
  <h1 class="page-title reveal">
    <em>Valentin Motors</em>
    {t('nav.coches')}
  </h1>
  <p class="catalog-meta reveal delay-1">
    {disponibles} {disponibles === 1 ? 'vehiculo' : 'vehiculos'} &middot; {actualizado}
  </p>
</header>

<div class="cars-grid">
  {coches.map((c, i) => <TarjetaCoche coche={c} idioma={idioma} indice={i} />)}
</div>

{(landings.length > 0 || vender) && (
  <aside class="catalogo-mas">
    {landings.length > 0 && (
      <div class="catalogo-mas-bloque">
        <p class="catalogo-mas-titulo">{t('catalogo.generaciones')}</p>
        <ul class="catalogo-mas-lista">
          {landings.map((l) => (
            <li>
              <a href={url(l.pagina!.rutaId, idioma)}>{l.pagina!.h1}</a>
              <span class="catalogo-mas-cuenta">
                {l.unidades > 0 ? `${l.unidades} ${t(l.unidades === 1 ? 'generacion.unidad' : 'generacion.unidades')}` : t('generacion.ninguna')}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}
    {vender && (
      <div class="catalogo-mas-bloque">
        <p class="catalogo-mas-titulo">{t('catalogo.vende')}</p>
        <ul class="catalogo-mas-lista">
          <li><a href={url(vender.rutaId, idioma)}>{vender.h1}</a></li>
        </ul>
      </div>
    )}
  </aside>
)}
