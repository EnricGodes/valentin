---
/**
 * Calculadora IMS.
 *
 * Tres campos y un boton. Todo lo demas aparece solo cuando hace falta:
 *
 *   - La aclaracion sale JUNTO al campo que hay que rellenar, con una linea
 *     que dice por que se pregunta. No es un resultado fallido, es un paso.
 *   - El resultado empieza por el veredicto y una linea. Debajo, sin nada que
 *     desplegar, la explicacion larga, el porque y el aviso.
 *   - La caja de afinado solo aparece si puede cambiar ESE resultado, y solo
 *     con los campos que lo cambian. Esos campos dependen del coche, asi que
 *     se construyen en el cliente y no hay plantillas aqui.
 *
 * El componente solo pinta. La logica vive en src/logica/ims y la comparten la
 * pagina y el articulo: un unico motor de reglas.
 */
import { OPCIONES, UI } from '../logica/ims/textos.es.ts';
import { VERSION_REGLAS } from '../logica/ims/reglas.ts';

interface Props {
  compacta?: boolean;
  /* Dentro del articulo no se pasa: enlazar al articulo desde el articulo. */
  enlaceArticulo?: string;
}
const { compacta = false, enlaceArticulo } = Astro.props;
const anoMax = new Date().getFullYear() + 1;
---
<section class:list={['ims', compacta && 'ims--compacta']} data-ims
         data-version={VERSION_REGLAS} data-articulo={enlaceArticulo}>
  <form class="ims-form" data-ims-form novalidate>
    <div class="ims-campos">
      <p class="ims-campo">
        <label for="ims-familia">{UI.modelo}</label>
        <select id="ims-familia" name="familia">
          {OPCIONES.familia.map((o) => <option value={o.valor}>{o.etiqueta}</option>)}
        </select>
      </p>

      <p class="ims-campo ims-campo--ano">
        <label for="ims-ano">{UI.ano}</label>
        <input id="ims-ano" name="ano" type="number" inputmode="numeric"
               placeholder="2003" min="1948" max={anoMax}
               aria-describedby="ims-ano-ayuda">
        <span class="ims-ayuda" id="ims-ano-ayuda">{UI.anoAyuda}</span>
      </p>

      {/* De segundo orden: mismo campo, menos peso visual. */}
      <p class="ims-campo ims-campo--menor">
        <label for="ims-base">{UI.baseAno}</label>
        <select id="ims-base" name="baseAno">
          {OPCIONES.baseAno.map((o) => <option value={o.valor}>{o.etiqueta}</option>)}
        </select>
      </p>
    </div>

    {/* La aclaracion, cuando toca, se pinta aqui: pegada al boton y al campo. */}
    <div class="ims-pregunta" data-ims-pregunta hidden></div>

    <p class="ims-error" data-ims-error role="alert" hidden></p>

    <button class="cta ims-enviar" type="submit" data-ims-enviar>{UI.calcular}</button>
  </form>

  <div class="ims-salida" data-ims-resultado aria-live="polite" hidden></div>
</section>
