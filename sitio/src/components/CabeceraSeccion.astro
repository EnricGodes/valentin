---
interface Props {
  etiqueta: string;
  titulo: string;
  /** Segunda linea del titulo, en negrita: es el patron del sistema. */
  destacado?: string;
  shimmer?: boolean;
  /** Clase extra para el envoltorio. */
  clase?: string;
}
const { etiqueta, titulo, destacado, shimmer = true, clase = '' } = Astro.props;
---
{/* El envoltorio no es decorativo: sin el, al meter la cabecera dentro de un
    contenedor flex (como .kit-header) sus tres elementos se convertian en tres
    items de flex y se repartian a lo ancho de la fila. */}
<div class={`cabecera-seccion ${clase}`.trim()}>
  {shimmer && <div class="shimmer-line"></div>}
  <p class="section-label reveal">{etiqueta}</p>
  <h2 class="section-title reveal delay-1">
    {titulo}
    {destacado && <strong>{destacado}</strong>}
  </h2>
</div>
