---
interface Props {
  etiqueta: string;
  /** HTML del titulo. Lleva <strong> y <br> porque el salto de linea y el peso
      tipografico son parte del contenido editorial, no del maquetado: se
      extraen tal cual de la ficha original. */
  titulo?: string;
  /** Atajo para el patron habitual "titulo normal + segunda linea en negrita". */
  destacado?: string;
  shimmer?: boolean;
  clase?: string;
}
const { etiqueta, titulo = '', destacado, shimmer = true, clase = '' } = Astro.props;
const html = destacado ? `${titulo}<strong>${destacado}</strong>` : titulo;
---
{/* El envoltorio no es decorativo: sin el, dentro de un contenedor flex como
    .kit-header los tres elementos se repartian a lo ancho de la fila. */}
<div class={`cabecera-seccion ${clase}`.trim()}>
  {shimmer && <div class="shimmer-line"></div>}
  <p class="section-label reveal">{etiqueta}</p>
  <h2 class="section-title reveal delay-1" set:html={html} />
</div>
