---
import type { SeccionPagina } from '../datos/pagina';
import { enlazaEnIdioma } from '../i18n/routes';
import { POR_DEFECTO, type Idioma } from '../i18n/config';
import { traductor } from '../i18n/ui';
import CalculadoraIms from './CalculadoraIms.astro';
import { url } from '../i18n/routes';

interface Props { secciones: SeccionPagina[]; idioma?: Idioma; }
const { secciones, idioma = POR_DEFECTO } = Astro.props;
const t = traductor(idioma);

/* Un testimonio viene de Squarespace como un H3 que empieza por comillas,
   con el nombre del cliente en el unico parrafo. No es una seccion: es una
   voz ajena en medio del texto, y se pinta como tal, en serif y con firma.
   Se reconoce por la forma (las comillas cambian por idioma: “ « „ "). */
const COMILLAS = /^[“”"«»„]+|[“”"«»„]+$/g;
const esTestimonio = (s: SeccionPagina) =>
  s.nivel === 3 && /^[“"«„]/.test(s.titulo.trim()) && !s.items.length && !s.imagenes.length;
const firma = (s: SeccionPagina) =>
  s.parrafos.map((p) => p.replace(/<[^>]+>/g, '').replace(/^[\s—–-]+/, '').trim())
            .filter(Boolean).join(' · ');

/** La primera seccion suele repetir el h1: no se pinta dos veces. */
const utiles = secciones.filter((s, i) =>
  !(i === 0 && s.nivel === 1) &&
  (s.titulo || s.parrafos.length || s.items.length || s.imagenes.length));
---
<div class="contenido">
  {utiles.map((s, i) => esTestimonio(s) ? (
    <figure class="testimonio reveal">
      <span class="testimonio-comilla" aria-hidden="true">“</span>
      <blockquote class="testimonio-cita">
        <p>{s.titulo.trim().replace(COMILLAS, '').trim()}</p>
      </blockquote>
      {firma(s) && (
        <figcaption class="testimonio-firma">{firma(s)} &middot; {t('testimonio.rol')}</figcaption>
      )}
    </figure>
  ) : (<>
    <section class={`bloque${s.imagenes.length ? ' bloque--con-foto' : ''}`}>
      <div class="bloque-texto">
        {s.titulo && (s.nivel <= 2
          ? <h2 class="bloque-titulo reveal">{s.titulo}</h2>
          : <h3 class="bloque-subtitulo reveal">{s.titulo}</h3>)}
        {s.parrafos.length > 0 && (
          <div class="texto-editorial reveal delay-1">
            {s.parrafos.map((p) => <p set:html={enlazaEnIdioma(p, idioma)} />)}
          </div>
        )}
        {s.items.length > 0 && (
          <ul class="bloque-lista reveal delay-1">{s.items.map((x) => <li>{x}</li>)}</ul>
        )}
        {s.enlace && (
          <p class="bloque-enlace reveal delay-2">
            <a class="cta" href={enlazaEnIdioma(`href="${s.enlace.href}"`, idioma).replace(/^href="|"$/g, '')}>{s.enlace.texto}</a>
          </p>
        )}
      </div>
      {s.imagenes.length > 0 && (
        <div class={`bloque-fotos bloque-fotos--${Math.min(s.imagenes.length, 3)}`}>
          {s.imagenes.map((im, j) => (
            <img src={im.url} alt={im.alt} loading={i === 0 && j === 0 ? 'eager' : 'lazy'}
                 decoding="async" class="reveal-scale">
          ))}
        </div>
      )}
    </section>
    {s.modulo === 'calculadora-ims' && (
      <div class="bloque bloque--modulo herr-envoltorio">
        <CalculadoraIms compacta idioma={idioma} enlaceArticulo={url('magazine', idioma, 'que-es-el-ims-de-porsche')} />
      </div>
    )}
  </>))}
</div>
