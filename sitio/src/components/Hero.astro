---
interface Props {
  eyebrow?: string;
  /** Subtitulo: se pinta dentro del <em> del titulo, como en el original. */
  subtitulo?: string;
  /** HTML del titulo: puede llevar <br> y <strong>. */
  titulo: string;
  claim?: string;
  imagen: string;
  /** Video de fondo opcional. La imagen queda de poster y de reserva. */
  video?: string;
  /** Version ligera del video para movil (720 px de ancho). */
  videoMovil?: string;
  precio?: string;
  precioLabel?: string;
  scrollLabel: string;
  /** Intensidad del parallax; 0 lo desactiva. */
  parallax?: number;
  /** Sin las clases .reveal: la entrada la anima la propia pagina (home). */
  sinReveal?: boolean;
  clase?: string;
}
const { eyebrow, subtitulo, titulo, claim, imagen, video, videoMovil, precio,
        precioLabel, scrollLabel, parallax = 0.28, sinReveal = false,
        clase = '' } = Astro.props;
const reveal = sinReveal ? '' : ' reveal';
---
<section class={`hero ${clase}`.trim()}>
  <div class="hero-parallax" data-parallax={parallax}>
    {/* Imagen real y no background-image: el navegador la encuentra al leer el
        HTML y la pide la primera. Es el LCP de casi todas las paginas. */}
    <div class="hero-bg" data-fondo={imagen}>
      <img src={imagen} alt="" fetchpriority="high" decoding="async" />
    </div>
    {/* El video no lleva src: lo pone fondos.ts cuando la pagina ha cargado,
        para que sus megas no compitan con la imagen y el texto. */}
    {video && (
      <video class="hero-video" data-src={video} data-src-movil={videoMovil}
             poster={imagen} muted loop playsinline preload="auto" aria-hidden="true"></video>
    )}
  </div>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    {eyebrow && <p class={`hero-eyebrow${reveal}`}>{eyebrow}</p>}
    <h1 class={`hero-title${reveal}`} set:html={
      (subtitulo ? `<em>${subtitulo}</em>` : '') + titulo
    } />
    {claim && <p class={`hero-claim${reveal}`}>{claim}</p>}
  </div>

  {precio && (
    <div class="hero-badge">
      <span class="hero-badge-price">{precio}</span>
      {precioLabel && <span class="hero-badge-label">{precioLabel}</span>}
    </div>
  )}

  <div class="hero-scroll" aria-hidden="true">
    <span>{scrollLabel}</span>
    <div class="scroll-line"></div>
  </div>
</section>
