---
/**
 * PA10/01: pagina editorial propia, con un sistema de diseno independiente del
 * resto del sitio (fondo claro, Nimbus Sans, filete granate).
 *
 * Viene del paquete PA10-01_Web_Claude_Code.zip. Aislamiento:
 *  - todas las clases llevan el prefijo p10- (styles/pa10.css), asi que ni
 *    system.css ni scripts/reveal.ts la tocan, ni ella a ellas;
 *  - la animacion vive en scripts/pa10.ts y solo actua si existe .p10;
 *  - no lleva cabecera ni pie propios: usa la navegacion del sitio.
 * Imagenes en public/img/pa10-01/, tipografias en public/fonts/pa10-01/.
 * La capa p10-hero-car es el recorte del coche (Vision de macOS sobre hero-1920):
 * va por encima del titulo para que la carroceria tape parte del "1".
 * Los textos, en los seis idiomas, estan en src/datos/pa10.ts.
 * Los datos mecanicos de la ficha son provisionales (specifications.json del
 * paquete): hasta confirmarlos siguen marcados como tales en la propia pagina.
 */
import '../styles/pa10.css';
import type { Idioma } from '../i18n/config';
import { TEXTOS_PA10 } from '../datos/pa10';

interface Props { idioma: Idioma; }
const { idioma } = Astro.props;
const x = TEXTOS_PA10[idioma];
const f = x.fotos;
---
<div class="p10">
<noscript><style>.p10-hero h1{opacity:1!important;transform:none!important}</style></noscript>
<div class="p10-reading-progress" aria-hidden="true"></div>

 <div class="p10-hero-pin">
 <section class="p10-hero" id="inicio" aria-labelledby="hero-title">
  <div class="p10-hero-media"><img  src="/img/pa10-01/hero-1280.webp" srcset="/img/pa10-01/hero-720.webp 720w, /img/pa10-01/hero-1280.webp 1280w, /img/pa10-01/hero-1920.webp 1672w" sizes="100vw" width="1672" height="941" alt={x.hero.alt} loading="eager" decoding="async" fetchpriority="high"></div>
  <div class="p10-hero-heading">
   <h1 id="hero-title">PA10/01</h1>
   <p class="p10-hero-subtitle">{x.hero.subtitulo}</p>
  </div>
  <div class="p10-hero-car" aria-hidden="true"><img src="/img/pa10-01/hero-car-1280.webp" srcset="/img/pa10-01/hero-car-720.webp 720w, /img/pa10-01/hero-car-1280.webp 1280w, /img/pa10-01/hero-car-1920.webp 1672w" sizes="100vw" width="1672" height="941" alt="" loading="eager" decoding="async"></div>
  <div class="p10-hero-shade" aria-hidden="true"></div>
  <div class="p10-hero-bottom"><a href="#vision">{x.hero.descubrir} <span class="p10-scroll-arrow" aria-hidden="true">↓</span></a></div>
 </section>
 </div>

 <section class="p10-vision p10-section-pad" id="vision" aria-labelledby="vision-title">
  <div class="p10-section-label p10-reveal"><span>01 / {x.vision.etiqueta}</span><span>PA10/01</span></div>
  <div class="p10-intro-grid">
   <h2 class="p10-display p10-reveal" id="vision-title" set:html={x.vision.titulo} />
   <div class="p10-intro-copy p10-reveal"><p class="p10-lead" set:html={x.vision.entradilla} />{x.vision.parrafos.map((p) => <p>{p}</p>)}</div>
  </div>
  <div class="p10-vision-composition">
   <figure class="p10-photo p10-vision-main p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/front-quarter-1280.webp" srcset="/img/pa10-01/front-quarter-720.webp 720w, /img/pa10-01/front-quarter-1280.webp 1280w, /img/pa10-01/front-quarter-1920.webp 1672w" sizes="(max-width:700px) 100vw, 72vw" width="1672" height="941" alt={f['front-quarter'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['front-quarter'].pie}</span></figcaption></figure>
   <div class="p10-vision-aside"><p class="p10-side-thought p10-reveal" set:html={x.vision.aparte} /><figure class="p10-photo p10-vision-detail p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/bonnet-1280.webp" srcset="/img/pa10-01/bonnet-720.webp 720w, /img/pa10-01/bonnet-1280.webp 1280w, /img/pa10-01/bonnet-1920.webp 1672w" sizes="(max-width:700px) 55vw, 30vw" width="1672" height="941" alt={f['bonnet'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['bonnet'].pie}</span></figcaption></figure></div>
  </div>
 </section>

 <section id="exterior" class="p10-exterior" aria-labelledby="exterior-title">
  <div class="p10-section-pad p10-section-top"><div class="p10-section-label p10-reveal"><span>02 / {x.exterior.etiqueta}</span><span>{x.exterior.etiqueta2}</span></div><div class="p10-section-heading"><h2 class="p10-display p10-reveal" id="exterior-title" set:html={x.exterior.titulo} /><p class="p10-section-summary p10-reveal">{x.exterior.resumen}</p></div></div>
  <div class="p10-profile-band p10-reveal"><figure class="p10-photo p10-profile-photo"><div class="p10-image-frame"><img  src="/img/pa10-01/profile-1280.webp" srcset="/img/pa10-01/profile-720.webp 720w, /img/pa10-01/profile-1280.webp 1280w, /img/pa10-01/profile-1920.webp 1732w" sizes="100vw" width="1732" height="908" alt={f['profile'].alt} loading="lazy" decoding="async"></div></figure><div class="p10-profile-caption"><span>{x.exterior.perfil[0]}</span><span>{x.exterior.perfil[1]}</span></div></div>
  <div class="p10-exterior-pair p10-section-pad">
   <div class="p10-wheel-column"><figure class="p10-photo p10-wheel-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/wheel-1280.webp" srcset="/img/pa10-01/wheel-720.webp 720w, /img/pa10-01/wheel-1280.webp 1280w, /img/pa10-01/wheel-1920.webp 1672w" sizes="(max-width:700px) 85vw, 34vw" width="1672" height="941" alt={f['wheel'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['wheel'].pie}</span></figcaption></figure><p class="p10-detail-note p10-reveal" set:html={x.exterior.fuchs} /></div>
   <div class="p10-rear-column"><div class="p10-micro-heading p10-reveal"><span class="p10-hairline"></span><p set:html={x.exterior.equilibrio} /></div><figure class="p10-photo p10-rear-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/rear-quarter-1280.webp" srcset="/img/pa10-01/rear-quarter-720.webp 720w, /img/pa10-01/rear-quarter-1280.webp 1280w, /img/pa10-01/rear-quarter-1920.webp 1672w" sizes="(max-width:700px) 100vw, 56vw" width="1672" height="941" alt={f['rear-quarter'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['rear-quarter'].pie}</span></figcaption></figure><p class="p10-rear-description p10-reveal">{x.exterior.trasera}</p></div>
  </div>
 </section>

 <section class="p10-interior p10-section-pad" id="interior" aria-labelledby="interior-title">
  <div class="p10-section-label p10-reveal"><span>03 / {x.interior.etiqueta}</span><span>{x.interior.etiqueta2}</span></div>
  <div class="p10-interior-heading"><h2 class="p10-display p10-reveal" id="interior-title" set:html={x.interior.titulo} /><div class="p10-material-legend p10-reveal" aria-label={x.interior.leyenda}><span><i class="p10-swatch p10-cream"></i>{x.interior.crema}</span><span><i class="p10-swatch p10-burgundy"></i>{x.interior.cuero}</span><span><i class="p10-swatch p10-tartan"></i>{x.interior.tartan}</span></div></div>
  <figure class="p10-photo p10-interior-wide p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/interior-1280.webp" srcset="/img/pa10-01/interior-720.webp 720w, /img/pa10-01/interior-1280.webp 1280w, /img/pa10-01/interior-1920.webp 1672w" sizes="100vw" width="1672" height="941" alt={f['interior'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['interior'].pie}</span></figcaption></figure>
  <div class="p10-interior-story">
   <div class="p10-interior-copy p10-reveal"><span class="p10-eyebrow">{x.interior.caracter.antetitulo}</span><h3 set:html={x.interior.caracter.titulo} />{x.interior.caracter.parrafos.map((p) => <p>{p}</p>)}</div>
   <figure class="p10-photo p10-seat-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/seat-1280.webp" srcset="/img/pa10-01/seat-720.webp 720w, /img/pa10-01/seat-1280.webp 1280w, /img/pa10-01/seat-1920.webp 1672w" sizes="(max-width:700px) 100vw, 48vw" width="1672" height="941" alt={f['seat'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['seat'].pie}</span></figcaption></figure>
  </div>
  <div class="p10-cockpit-sequence">
   <div class="p10-cockpit-instruments"><figure class="p10-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/instruments-1280.webp" srcset="/img/pa10-01/instruments-720.webp 720w, /img/pa10-01/instruments-1280.webp 1280w, /img/pa10-01/instruments-1920.webp 1672w" sizes="(max-width:700px) 100vw, 61vw" width="1672" height="941" alt={f['instruments'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['instruments'].pie}</span></figcaption></figure><div class="p10-cockpit-caption p10-reveal"><span class="p10-eyebrow">{x.interior.mirada.antetitulo}</span><p set:html={x.interior.mirada.texto} /></div></div>
   <div class="p10-cockpit-gesture"><div class="p10-gesture-copy p10-reveal"><span class="p10-eyebrow">{x.interior.gesto.antetitulo}</span><h3 set:html={x.interior.gesto.titulo} /><p>{x.interior.gesto.texto}</p></div><figure class="p10-photo p10-console-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/console-1280.webp" srcset="/img/pa10-01/console-720.webp 720w, /img/pa10-01/console-1280.webp 1280w, /img/pa10-01/console-1920.webp 1672w" sizes="(max-width:700px) 100vw, 52vw" width="1672" height="941" alt={f['console'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['console'].pie}</span></figcaption></figure></div>
   <div class="p10-cockpit-materials"><figure class="p10-photo p10-dashboard-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/dashboard-1280.webp" srcset="/img/pa10-01/dashboard-720.webp 720w, /img/pa10-01/dashboard-1280.webp 1280w, /img/pa10-01/dashboard-1920.webp 1672w" sizes="(max-width:700px) 75vw, 42vw" width="1672" height="941" alt={f['dashboard'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['dashboard'].pie}</span></figcaption></figure><p class="p10-side-thought p10-reveal" set:html={x.interior.aparte} /></div>
  </div>
 </section>

 <section id="oficio" class="p10-craft p10-section-pad" aria-labelledby="craft-title">
  <div class="p10-section-label p10-reveal"><span>04 / {x.oficio.etiqueta}</span><span>{x.oficio.etiqueta2}</span></div>
  <div class="p10-craft-intro"><h2 class="p10-display p10-reveal" id="craft-title" set:html={x.oficio.titulo} /><p class="p10-section-summary p10-reveal">{x.oficio.resumen}</p></div>
  <div class="p10-engine-layout"><figure class="p10-photo p10-engine-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/engine-1280.webp" srcset="/img/pa10-01/engine-720.webp 720w, /img/pa10-01/engine-1280.webp 1280w, /img/pa10-01/engine-1920.webp 1672w" sizes="(max-width:700px) 100vw, 63vw" width="1672" height="941" alt={f['engine'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['engine'].pie}</span></figcaption></figure><div class="p10-engine-copy p10-reveal"><span class="p10-eyebrow">{x.oficio.motor.antetitulo}</span><h3 set:html={x.oficio.motor.titulo} /><p>{x.oficio.motor.texto}</p></div></div>
  <div class="p10-detail-story" data-detail-story>
   <div class="p10-story-visual"><div class="p10-story-frames">
    <div class="p10-story-frame p10-is-active" data-frame="0"><figure class="p10-photo"><div class="p10-image-frame"><img  src="/img/pa10-01/headlight-1280.webp" srcset="/img/pa10-01/headlight-720.webp 720w, /img/pa10-01/headlight-1280.webp 1280w, /img/pa10-01/headlight-1920.webp 1672w" sizes="(max-width:700px) 100vw, 56vw" width="1672" height="941" alt={f['headlight'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['headlight'].pie}</span></figcaption></figure></div>
    <div class="p10-story-frame" data-frame="1"><figure class="p10-photo"><div class="p10-image-frame"><img  src="/img/pa10-01/mirror-1280.webp" srcset="/img/pa10-01/mirror-720.webp 720w, /img/pa10-01/mirror-1280.webp 1280w, /img/pa10-01/mirror-1920.webp 1672w" sizes="(max-width:700px) 100vw, 56vw" width="1672" height="941" alt={f['mirror'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['mirror'].pie}</span></figcaption></figure></div>
    <div class="p10-story-frame" data-frame="2"><figure class="p10-photo"><div class="p10-image-frame"><img  src="/img/pa10-01/rear-detail-1280.webp" srcset="/img/pa10-01/rear-detail-720.webp 720w, /img/pa10-01/rear-detail-1280.webp 1280w, /img/pa10-01/rear-detail-1920.webp 1672w" sizes="(max-width:700px) 100vw, 56vw" width="1672" height="941" alt={f['rear-detail'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['rear-detail'].pie}</span></figcaption></figure></div>
   </div><div class="p10-story-progress" aria-hidden="true"><span class="p10-is-active"></span><span></span><span></span></div></div>
   <div class="p10-story-text">
    {x.oficio.pasos.map((paso, i) => (
    <article class="p10-story-step" data-step={i}><span class="p10-eyebrow">0{i + 1} / {paso.antetitulo}</span><h3 set:html={paso.titulo} /><p>{paso.texto}</p></article>
    ))}
   </div>
  </div>
  <div class="p10-finishing-grid"><figure class="p10-photo p10-luggage-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/luggage-1280.webp" srcset="/img/pa10-01/luggage-720.webp 720w, /img/pa10-01/luggage-1280.webp 1280w, /img/pa10-01/luggage-1920.webp 1672w" sizes="(max-width:700px) 100vw, 56vw" width="1672" height="941" alt={f['luggage'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['luggage'].pie}</span></figcaption></figure><div class="p10-emblem-column"><p class="p10-side-thought p10-reveal" set:html={x.oficio.aparte} /><figure class="p10-photo p10-emblem-photo p10-reveal"><div class="p10-image-frame"><img  src="/img/pa10-01/emblem-1280.webp" srcset="/img/pa10-01/emblem-720.webp 720w, /img/pa10-01/emblem-1280.webp 1280w, /img/pa10-01/emblem-1920.webp 1672w" sizes="(max-width:700px) 80vw, 33vw" width="1672" height="941" alt={f['emblem'].alt} loading="lazy" decoding="async"></div><figcaption><span>{f['emblem'].pie}</span></figcaption></figure></div></div>
 </section>

 <section id="ficha" class="p10-specifications p10-section-pad" aria-labelledby="spec-title">
  <div class="p10-section-label p10-reveal"><span>05 / {x.ficha.etiqueta}</span><span>PA10/01</span></div>
  <div class="p10-spec-highlights p10-reveal"><div><span class="p10-metric-value">{x.ficha.cifras.litros}<small>L</small></span><span class="p10-metric-label">{x.ficha.cifras.cilindrada}</span></div><div><span class="p10-metric-value">320<small>{x.ficha.cifras.cv}</small></span><span class="p10-metric-label">{x.ficha.cifras.potencia}</span></div><div><span class="p10-metric-value">350<small>Nm</small></span><span class="p10-metric-label">{x.ficha.cifras.par}</span></div></div>
  <p class="p10-spec-draft-note">{x.ficha.borrador}</p>
  <div class="p10-spec-layout"><div class="p10-spec-intro p10-reveal"><h2 class="p10-display" id="spec-title" set:html={x.ficha.titulo} /><p set:html={x.ficha.intro} /></div>
   <div class="p10-spec-data p10-reveal">
    {x.ficha.grupos.map((g) => (<>
    <h3>{g.titulo}</h3><dl>{g.filas.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}</dl>
    </>))}
   </div>
  </div>
 </section>

 <section class="p10-closing" aria-label={x.cierre.region}>
  <div class="p10-closing-image"><img  src="/img/pa10-01/front-1280.webp" srcset="/img/pa10-01/front-720.webp 720w, /img/pa10-01/front-1280.webp 1280w, /img/pa10-01/front-1920.webp 1672w" sizes="100vw" width="1672" height="941" alt={f['front'].alt} loading="lazy" decoding="async"></div><div class="p10-closing-overlay"></div>
  <div class="p10-closing-copy p10-reveal"><span class="p10-eyebrow">{x.cierre.antetitulo}</span><h2 set:html={x.cierre.titulo} /><a class="p10-closing-button" href="#inicio">{x.cierre.volver} <span aria-hidden="true">↑</span></a></div>
 </section>
</div>
<script>
  import '../scripts/pa10.ts';
</script>
